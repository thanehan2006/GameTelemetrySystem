d #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">10</td><td style="width:13.98%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Events/​batch</span></td><td style="width:7.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">POST</span></td><td style="width:30.03%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CreateBatchGameEventsDto</span>: <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">{ &quot;sessionId&quot;: 14, &quot;events&quot;: [ { &quot;eventType&quot;: &quot;...&quot;, &quot;eventTime&quot;: &quot;...&quot;, &quot;value&quot;: 100 } ] }</span></td><td style="width:28.51%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">200 OK</span>: <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">{ &quot;message&quot;: &quot;Đã ghi nhận thành công N sự kiện&quot;, &quot;count&quot;: N }</span></td><td style="width:14.01%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">400 Bad Request</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">404 Not Found</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">11</td><td style="width:13.98%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Events/​{​id:long}​</span></td><td style="width:7.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET</span></td><td style="width:30.03%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Route param: <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">id</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">long</span>)</td><td style="width:28.51%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">200 OK</span>: <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEventResponseDto</span></td><td style="width:14.01%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">404 Not Found</span></td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">6.6. Các API thống kê</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Lớp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">AnalyticsController</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Analytics</span>) cung cấp <strong>7 API thống kê chuyên sâu</strong> phục vụ trực tiếp cho giao diện Web Dashboard. Tất cả các API thống kê theo phiên đều dùng chung hàm lọc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">FilterSessions(DateTime? from, DateTime? to, int? level)</span> để đảm bảo số liệu nhất quán tuyệt đối khi người dùng bật bộ lọc:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>API Thống kê tổng quan (GET /api/Analytics/overview):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Cung cấp các chỉ số KPI cốt lõi cho hàng thẻ đầu tiên trên Dashboard.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Lọc danh sách <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span> theo khoảng ngày <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">from</span> – <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">to</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level</span>. Tính tổng số người chơi (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TotalPlayers</span>), tổng số phiên (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TotalSessions</span>), tổng số sự kiện cột mốc (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TotalEvents</span>), thời lượng trung bình mỗi phiên đã kết thúc (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">AverageSessionDurationMinutes</span>), tổng số trận thắng (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TotalWins</span>), tổng số trận thua (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TotalLosses</span>), tỷ lệ thắng (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WinRatePercent</span>), tổng vàng nhặt/tiêu và tổng số quái/Boss bị tiêu diệt.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Query params tùy chọn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">from</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">DateTime?</span>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">to</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">DateTime?</span>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">int?</span>).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Đối tượng JSON <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OverviewStatsDto</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>API Thống kê tiến độ theo từng Level (GET /api/Analytics/levels):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Thống kê số lượt Bắt đầu, Hoàn thành, Tử trận và Tỷ lệ qua màn (%) của từng bản đồ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 1</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 2</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 3</span>).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Đọc danh mục tên bản đồ từ bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Levels</span>, lọc bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span> theo các sự kiện <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_start</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_complete</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">player_dead</span> có <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Value</span> thuộc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">1..3</span>, nhóm theo mã Level và tính CompletionRatePercent = Round((Completions / Starts) × 100, 1).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Query params tùy chọn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">from</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">to</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Danh sách JSON <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;LevelStatsDto&gt;</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>API Thống kê phân bố loại sự kiện (GET /api/Analytics/events-distribution):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Đếm số lượng xuất hiện của từng loại sự kiện cột mốc đang lưu trong bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Thực hiện <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GroupBy(e =&gt; e.EventType)</span> trên bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span> và sắp xếp giảm dần theo số lượng.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Không có tham số bắt buộc.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Danh sách JSON <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;EventCountDto&gt;</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>4.</strong>&nbsp;<strong>API Thống kê xu hướng phiên chơi theo ngày (GET /api/Analytics/sessions-by-date):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Cung cấp dữ liệu chuỗi thời gian cho biểu đồ đường (<em>Line Chart</em>) trên Dashboard.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Lọc các phiên chơi theo <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">from</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">to</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level</span>, định dạng ngày bắt đầu theo chuẩn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;yyyy-MM-dd&quot;</span>, nhóm và đếm số phiên chơi trong từng ngày theo thứ tự thời gian tăng dần.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Query params tùy chọn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">from</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">to</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Danh sách JSON <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;SessionsByDateDto&gt;</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>5.</strong>&nbsp;<strong>API Lấy danh sách phiên chơi gần đây (GET /api/Analytics/recent-sessions):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Hiển thị bảng nhật ký các phiên chơi mới nhất kèm đầy đủ thông số tóm tắt.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Sắp xếp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span> giảm dần theo <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StartTime</span>, lấy tối đa <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">limit</span> bản ghi (mặc định 15, Dashboard gọi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">limit=25</span>), kết hợp (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">JOIN</span>) với bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Players</span> để lấy <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerName</span> và tính tổng sự kiện <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TotalEvents = s.GameEvents.Count + s.ShopPurchases.Count</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Query params <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">limit</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">int</span>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">from</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">to</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Danh sách JSON <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;RecentSessionDto&gt;</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>6.</strong>&nbsp;<strong>API Phân tích kinh tế và Cửa hàng Lò Rèn (GET /api/Analytics/economy):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Phân tích dòng chảy Vàng (nhặt vs tiêu) và thống kê lượt mua của từng loại trong 8 vũ khí cũng như bình hồi máu.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Tính tổng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldEarned</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldSpent</span>, tỷ lệ tiêu vàng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SpendRatioPercent</span> và trung bình vàng mỗi phiên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">AvgGoldPerSession</span> từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span>. Sau đó truy vấn bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span> của các phiên thỏa bộ lọc, đối chiếu với 8 mẫu vũ khí trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponCatalog.Items</span> để lập bảng phân rã <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponBreakdown</span> (kèm nhóm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;Vũ khí khác (bản cũ)&quot;</span> nếu có dữ liệu từ phiên bản cũ).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Query params tùy chọn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">from</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">to</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Đối tượng JSON <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EconomyStatsDto</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>7.</strong>&nbsp;<strong>API Thống kê chỉ số chiến đấu cốt lõi (GET /api/Analytics/combat) và API Dòng thời gian phiên chơi (GET /api/Analytics/sessions/{sessionId}/events):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Analytics/combat</span>: Tổng hợp số quái bị hạ, số Boss bị hạ, tỷ lệ hạ Boss (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BossClearRatePercent</span>), số pha đỡ đòn (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BlockHits</span>), sát thương chặn được (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TotalBlockedDamage</span>), số pha phản đòn (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PerfectParries</span>), tỷ lệ thuần thục Parry (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ParryMasteryPercent</span>) và số lần/sát thương dính bẫy gai.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Analytics/sessions/{sessionId}/events</span>: Tái hiện lại toàn bộ diễn biến của một phiên chơi cụ thể theo trình tự thời gian bằng cách gộp (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Concat</span>) các sự kiện cột mốc trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span> và các giao dịch mua đồ trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span>, tính độ lệch giây <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OffsetSeconds = Round((EventTime - session.StartTime).TotalSeconds, 1)</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Query params <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">from</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">to</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level</span> (cho <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/combat</span>) hoặc Route param <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionId</span> (cho <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/sessions/{sessionId}/events</span>).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CombatStatsDto</span> hoặc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;SessionEventTimelineDto&gt;</span>.</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 6.2. Bảng đặc tả các Endpoint thống kê trong AnalyticsController</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:5.73%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">STT</th><th style="width:20.21%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Endpoint</th><th style="width:8.34%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Method</th><th style="width:14.82%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Query / Route Params</th><th style="width:15.74%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Response DTO (200 OK)</th><th style="width:35.16%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Các trường dữ liệu chính trong Response</th></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">1</td><td style="width:20.21%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​overview</span></td><td style="width:8.34%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET</span></td><td style="width:14.82%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">?​from=​&amp;​to=​&amp;​level=​</span></td><td style="width:15.74%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OverviewStatsDto</span></td><td style="width:35.16%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalPlayers</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalSessions</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalEvents</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">averageSessionDurationMinutes</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalWins</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalLosses</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">activeOrQuitSessions</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">winRatePercent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalGoldEarned</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalGoldSpent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalEnemiesKilled</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalBossKills</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">2</td><td style="width:20.21%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​levels</span></td><td style="width:8.34%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET</span></td><td style="width:14.82%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">?​level=​&amp;​from=​&amp;​to=​</span></td><td style="width:15.74%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;LevelStatsDto&gt;</span></td><td style="width:35.16%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">stageName</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">starts</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">completions</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">deaths</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">completionRatePercent</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">3</td><td style="width:20.21%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​events-​distribution</span></td><td style="width:8.34%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET</span></td><td style="width:14.82%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Không có</td><td style="width:15.74%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;EventCountDto&gt;</span></td><td style="width:35.16%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">eventType</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">count</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:20.21%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​sessions-​by-​date</span></td><td style="width:8.34%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET</span></td><td style="width:14.82%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">?​from=​&amp;​to=​&amp;​level=​</span></td><td style="width:15.74%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;SessionsByDateDto&gt;</span></td><td style="width:35.16%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">date</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;yyyy-MM-dd&quot;</span>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionCount</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">5</td><td style="width:20.21%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​recent-​sessions</span></td><td style="width:8.34%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET</span></td><td style="width:14.82%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">?​limit=​25&amp;​from=​&amp;​to=​&amp;​level=​</span></td><td style="width:15.74%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;RecentSessionDto&gt;</span></td><td style="width:35.16%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionId</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">playerName</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">startTime</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">endTime</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">durationMinutes</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">result</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalEvents</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">enemiesKilled</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">goldEarned</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">goldSpent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">perfectParries</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">6</td><td style="width:20.21%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​economy</span></td><td style="width:8.34%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET</span></td><td style="width:14.82%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">?​from=​&amp;​to=​&amp;​level=​</span></td><td style="width:15.74%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EconomyStatsDto</span></td><td style="width:35.16%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalGoldCollected</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalGoldSpent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">goldSpentOnWeapons</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">goldSpentOnPotions</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">spendRatioPercent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">avgGoldPerSession</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">weaponPurchaseCount</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">potionPurchaseCount</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">weaponBreakdown</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;WeaponPurchaseStatDto&gt;</span>)</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">7</td><td style="width:20.21%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​combat</span></td><td style="width:8.34%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET</span></td><td style="width:14.82%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">?​from=​&amp;​to=​&amp;​level=​</span></td><td style="width:15.74%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CombatStatsDto</span></td><td style="width:35.16%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalEnemyKills</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">bossKills</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">stage3Starts</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">bossClearRatePercent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">blockHits</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalBlockedDamage</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">perfectParries</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">parryMasteryPercent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">trapHits</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalTrapDamage</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">8</td><td style="width:20.21%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​sessions/​{​sessionId:long}​/​events</span></td><td style="width:8.34%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET</span></td><td style="width:14.82%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Route: <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionId</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">long</span>)</td><td style="width:15.74%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">List&lt;SessionEventTimelineDto&gt;</span></td><td style="width:35.16%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">eventId</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">eventType</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">eventTime</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">value</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">offsetSeconds</span></td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">6.7. Kiểm thử API bằng Swagger</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Trong tệp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Program.cs</span>, dịch vụ <strong>Swagger (OpenAPI)</strong> được kích hoạt trong môi trường phát triển (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">app.Environment.IsDevelopment()</span>) tại đường dẫn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/swagger</span>:</p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:6pt 0 10pt 0;border:1pt solid #cbd5e1;border-left:3pt solid #1e3a8a;background:#f8fafc;"><tr><td style="padding:6pt 8pt;word-wrap:break-word;overflow-wrap:break-word;"><div style="color:#1e3a8a;font-family:Consolas,monospace;font-size:9pt;font-weight:bold;margin-bottom:3pt;">[CSHARP]</div><div style="font-family:Consolas,monospace;font-size:8.5pt;color:#0f172a;line-height:1.3;word-wrap:break-word;">if (​app.​Environment.​IsDevelopment(​)​)​</div><div style="font-family:Consolas,monospace;font-size:8.5pt;color:#0f172a;line-height:1.3;word-wrap:break-word;">{</div><div style="font-family:Consolas,monospace;font-size:8.5pt;color:#0f172a;line-height:1.3;word-wrap:break-word;">&nbsp;&nbsp;&nbsp;&nbsp;app.​UseSwagger(​)​;​</div><div style="font-family:Consolas,monospace;font-size:8.5pt;color:#0f172a;line-height:1.3;word-wrap:break-word;">&nbsp;&nbsp;&nbsp;&nbsp;app.​UseSwaggerUI(​c =&gt;</div><div style="font-family:Consolas,monospace;font-size:8.5pt;color:#0f172a;line-height:1.3;word-wrap:break-word;">&nbsp;&nbsp;&nbsp;&nbsp;{</div><div style="font-family:Consolas,monospace;font-size:8.5pt;color:#0f172a;line-height:1.3;word-wrap:break-word;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;c.​SwaggerEndpoint(​&quot;/​swagger/​v1/​swagger.​json&quot;,​ &quot;GameTelemetryAPI v1&quot;);</div><div style="font-family:Consolas,monospace;font-size:8.5pt;color:#0f172a;line-height:1.3;word-wrap:break-word;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;c.RoutePrefix = &quot;swagger&quot;;</div><div style="font-family:Consolas,monospace;font-size:8.5pt;color:#0f172a;line-height:1.3;word-wrap:break-word;">&nbsp;&nbsp;&nbsp;&nbsp;});</div><div style="font-family:Consolas,monospace;font-size:8.5pt;color:#0f172a;line-height:1.3;word-wrap:break-word;">}</div></td></tr></table><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Khi khởi chạy dự án Backend (cổng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">https://localhost:7013</span> hoặc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">http://localhost:5295</span>), người kiểm thử và lập trình viên có thể truy cập <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">http://localhost:5295/swagger</span> để xem danh sách toàn bộ 19 Endpoint được nhóm theo 5 Controllers (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Analytics</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Events</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">HealthCheck</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Players</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Sessions</span>), thực hiện thao tác <strong>&quot;Try it out&quot;</strong> để gửi JSON mẫu và kiểm tra trực tiếp mã phản hồi HTTP cũng như cấu trúc JSON trả về từ SQL Server.</p><p style="text-align:center;margin:10pt 0 3pt 0;"><span style="color:#1d4ed8;background:#eff6ff;font-weight:bold;padding:2pt 4pt;border:1pt dashed #1d4ed8;">[CHÈN HÌNH ẢNH: Giao diện Swagger UI hiển thị danh sách các API của GameTelemetryAPI]</span></p><p style="text-align:center;font-style:italic;color:#334155;font-size:12pt;margin:2pt 0 12pt 0;">Hình 6.1. Giao diện tài liệu và kiểm thử trực quan Swagger UI của hệ thống Backend <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryAPI</span>.</p><p style="text-align:center;margin:10pt 0 3pt 0;"><span style="color:#1d4ed8;background:#eff6ff;font-weight:bold;padding:2pt 4pt;border:1pt dashed #1d4ed8;">[CHÈN HÌNH ẢNH: Kết quả thực thi thử nghiệm API GET /api/Analytics/overview trên Swagger UI]</span></p><p style="text-align:center;font-style:italic;color:#334155;font-size:12pt;margin:2pt 0 12pt 0;">Hình 6.2. Kiểm thử Endpoint <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET /api/Analytics/overview</span> trên Swagger UI trả về dữ liệu thống kê từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>.</p><hr style="border:none;border-bottom:1pt solid #cbd5e1;margin:12pt 0;"/><h1 style="font-family:'Times New Roman',serif;font-size:16pt;color:#1e3a8a;font-weight:bold;margin:16pt 0 8pt 0;page-break-after:avoid;">CHƯƠNG 7. XÂY DỰNG GAME CLIENT</h1><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">7.1. Giới thiệu trò chơi</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Trò chơi Client trong dự án mang tên <strong>Vanguard: Raid of the Orc Woods</strong>, thuộc thể loại <strong>Hành động nhập vai góc nhìn thứ ba kết hợp yếu tố Roguelite (3D Third-Person Action Roguelite / Dark Fantasy)</strong>, được phát triển trên <strong>Unity 6 (6000.3.19f1)</strong> sử dụng đường ống kết xuất đồ họa <strong>Universal Render Pipeline (URP)</strong>.</p><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;"><strong>Bối cảnh trò chơi:</strong> Quân đoàn quái vật Orc, người khổng lồ băng giá và chúa tể dung nham đã xâm chiếm 3 vùng đất chiến lược cùng các khu mỏ vàng cổ đại. Người chơi hóa thân thành một chiến binh thuộc quân đoàn tiên phong (<em>Vanguard</em>), lựa chọn 1 trong 4 lớp nhân vật thông qua cấu hình <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CharacterRosterConfig</span> và tiến vào giải phóng lần lượt 3 bản đồ chiến dịch:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Level 1 (Lv1.unity) – Rừng Orc &amp; Mỏ Vàng:</strong> Địa hình rừng rậm ngoại vi và khu mỏ vàng cổ, đối đầu với quân trinh sát Orc, lính khiên và Boss <strong>Đại Tướng Orc Warlord</strong> (Hệ số độ khó <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">1.00x</span>).</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Level 2 (Lv2.unity) – Cao Nguyên Băng Tuyết:</strong> Vùng núi tuyết khắc nghiệt với hiệu ứng tuyết rơi và cực quang (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BiomeTheme.FrostAurora</span>), đối đầu với Boss <strong>Frost Colossus</strong> (Hệ số độ khó <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">1.25x</span>).</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Level 3 (Lv3.unity) – Pháo Đài Dung Nham:</strong> Khu vực núi lửa và mạch dung nham nóng chảy (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BiomeTheme.InfernoHold</span>), đối đầu với Boss <strong>Inferno Overlord</strong> (Hệ số độ khó <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">1.50x</span>).</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">7.2. Thiết kế gameplay</h2><h3 style="font-family:'Times New Roman',serif;font-size:13pt;color:#1e40af;font-weight:bold;font-style:italic;margin:10pt 0 5pt 0;page-break-after:avoid;">7.2.1. Cấu trúc tiến trình 3 Khu vực (3 Stages) trong mỗi Bản đồ</h3><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Mỗi bản đồ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">1 Map = 1 Level</span>) được điều phối bởi kịch bản trung tâm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StageManager.cs</span>, chia thành 3 khu vực chiến đấu nối tiếp nhau trên địa hình <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Terrain</span>:</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Khu vực 1 (Màn 1/3 – Trại Ngoại Vi):</strong> Người chơi chiến đấu tiêu diệt 2 đợt (<em>Waves</em>) quái trinh sát và lính rìu. Khi quét sạch cả 2 đợt, hệ thống phát âm thanh qua màn, rơi bình hồi máu và bật <strong>Cột sáng dẫn đường (Waypoint Beacon)</strong> màu vàng chỉ hướng sang Khu vực 2.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Khu vực 2 (Màn 2/3 – Thung Lũng Bẫy &amp; Lính Khiên):</strong> Khu vực có bố trí <strong>6 cụm Bẫy Gai (TrapHazard)</strong> phát vòng sáng cảnh báo màu đỏ dưới mặt đất (gây <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">18 HP</span> sát thương mỗi lần dẫm phải). Người chơi phải vừa né bẫy gai, vừa tiêu diệt 2 đợt quái gồm Lính Khiên (<em>Tanker</em> máu cao, kháng đẩy lùi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0.60</span>) và Lính Đột Kích (<em>Striker</em>).</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Khu vực 3 (Màn 3/3 – Đấu Trường Boss):</strong> Khi người chơi tiến vào bán kính <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">28m</span> quanh tâm đấu trường, hệ thống chuyển nhạc nền sang <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BgmTrack.Boss</span>, hiển thị thanh máu Boss trên đỉnh màn hình và triệu hồi Boss cuối của bản đồ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">700 HP</span> cơ bản nhân với hệ số độ khó bản đồ). Đặc biệt, khi máu Boss giảm xuống dưới <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">50%</span>, Boss kích hoạt trạng thái <strong>Cuồng Nộ (Boss Enrage)</strong>: tăng tốc độ di chuyển lên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">4.5 m/s</span>, tăng sát thương đòn đánh và triệu hồi thêm 2–3 lính hộ vệ (<em>Boss Guards</em>).</p><h3 style="font-family:'Times New Roman',serif;font-size:13pt;color:#1e40af;font-weight:bold;font-style:italic;margin:10pt 0 5pt 0;page-break-after:avoid;">7.2.2. Cơ chế Chiến đấu, Phòng thủ và Phản đòn (Combat &amp; Parry System)</h3><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Tấn công cận chiến &amp; Tự động khóa mục tiêu (PlayerAttack.cs):</strong> Nhấn Chuột Trái (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LMB</span>) để thực hiện chuỗi combo 3 đòn đánh (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Atk1</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Atk2</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Atk3</span>), trong đó đòn thứ 3 là đòn xoay kiếm diện rộng gây <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">115%</span> sát thương và tăng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">25%</span> lực đẩy lùi. Hỗ trợ phím <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Tab</span> để khóa mục tiêu (<em>Target Lock-On</em>) kèm vòng ngắm kim cương xoay dưới chân quái và phím <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Q</span> để hủy khóa.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Đỡ đòn thường (Block) và Phản đòn hoàn hảo (Perfect Parry) (PlayerController.cs, OrcWeaponHitbox.cs):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Khi người chơi giữ Chuột Phải (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">RMB</span>), nhân vật bật khiên năng lượng (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerBlockAuraFX</span>). Nếu bị quái đánh trúng khi đang giữ khiên, sát thương nhận vào được giảm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">72%</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">blockDamageReduction = 0.72f</span>) và hệ thống ghi nhận sự kiện <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">block_hit</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Nếu người chơi bấm giữ Chuột Phải đúng vào <strong>khung thời gian 0.28 giây đầu tiên</strong> trước khi lưỡi rìu của quái chạm người (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IsPerfectParryWindow</span>), hệ thống kích hoạt <strong>Perfect Parry</strong>: miễn nhiễm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">100%</span> sát thương đòn đó, hồi ngay <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">6%</span> máu tối đa cho nhân vật, đánh bật và làm <strong>choáng quái trong 1.6 giây (ApplyParryStun)</strong>, đồng thời ghi nhận sự kiện <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">perfect_parry</span>.</p><h3 style="font-family:'Times New Roman',serif;font-size:13pt;color:#1e40af;font-weight:bold;font-style:italic;margin:10pt 0 5pt 0;page-break-after:avoid;">7.2.3. Hệ thống Kinh tế Vàng và Cửa hàng Lò Rèn (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ScoreManager.cs</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponShopManager.cs</span>)</h3><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Khi tiêu diệt quái thường, hệ thống tung ra 3 đồng vàng/túi vàng nảy vật lý trên mặt đất (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldPickup.SpawnGoldBurst</span>); khi tiêu diệt Boss, hệ thống tung ra rương vàng lớn trị giá <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">220 G</span>. Đồng vàng tự động bị hút vào người chơi khi đứng trong bán kính <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">2.35m</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Người chơi có thể kích hoạt các <strong>Trạm Lửa Trại (CampfireCheckpoint)</strong> tại mỗi khu vực để nhận hồi máu tức thì (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+30</span> đến <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+55 HP</span>) và nhấn phím <strong>[B]</strong> (hoặc phím <strong>[E]</strong> khi đứng gần lửa trại) để mở <strong>Cửa hàng Lò Rèn Vanguard</strong>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Cửa hàng cung cấp <strong>Bình Hồi Máu Huyết Ngọc</strong> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">65 G</span>, hồi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+75 HP</span>) và <strong>8 loại Vũ khí nâng cấp</strong> đồng bộ giữa <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponUpgradeConfigSO</span> trên Unity và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponCatalog.cs</span> trên Backend:</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 7.1. Danh mục 8 Vũ khí và Bình hồi máu trong Cửa hàng Lò Rèn</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:7.84%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">STT</th><th style="width:24.39%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Tên vật phẩm</th><th style="width:16.99%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Phân loại</th><th style="width:14.38%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Bậc phẩm chất</th><th style="width:16.34%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Giá mua (Gold)</th><th style="width:20.07%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Chỉ số cộng thêm</th></tr><tr><td style="width:7.84%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">1</td><td style="width:24.39%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Bình Hồi Máu Huyết Ngọc</td><td style="width:16.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Potion</span></td><td style="width:14.38%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Tiêu Hao</td><td style="width:16.34%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">65 G</span></td><td style="width:20.07%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Hồi ngay <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+75 HP</span></td></tr><tr><td style="width:7.84%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">2</td><td style="width:24.39%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Ngân Phong Kiếm</td><td style="width:16.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Weapon</span></td><td style="width:14.38%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Hiếm</td><td style="width:16.34%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">75 G</span></td><td style="width:20.07%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+8 Sát thương</span></td></tr><tr><td style="width:7.84%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">3</td><td style="width:24.39%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Thiên Lam Kiếm</td><td style="width:16.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Weapon</span></td><td style="width:14.38%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Hiếm</td><td style="width:16.34%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">130 G</span></td><td style="width:20.07%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+14 Sát thương</span></td></tr><tr><td style="width:7.84%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:24.39%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Nham Thạch Chiến Chùy</td><td style="width:16.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Weapon</span></td><td style="width:14.38%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Sử Thi</td><td style="width:16.34%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">200 G</span></td><td style="width:20.07%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+21 Sát thương</span></td></tr><tr><td style="width:7.84%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">5</td><td style="width:24.39%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Huyết Diễm Đoản Đao</td><td style="width:16.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Weapon</span></td><td style="width:14.38%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Sử Thi</td><td style="width:16.34%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">280 G</span></td><td style="width:20.07%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+28 Sát thương</span></td></tr><tr><td style="width:7.84%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">6</td><td style="width:24.39%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Hàn Ngọc Thánh Kiếm</td><td style="width:16.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Weapon</span></td><td style="width:14.38%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Huyền Thoại</td><td style="width:16.34%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">370 G</span></td><td style="width:20.07%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+36 Sát thương</span></td></tr><tr><td style="width:7.84%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">7</td><td style="width:24.39%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Lôi Quang Kim Thương</td><td style="width:16.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Weapon</span></td><td style="width:14.38%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Huyền Thoại</td><td style="width:16.34%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">470 G</span></td><td style="width:20.07%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+44 Sát thương</span></td></tr><tr><td style="width:7.84%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">8</td><td style="width:24.39%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Lưỡi Hái Huyết Nguyệt</td><td style="width:16.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Weapon</span></td><td style="width:14.38%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Thần Thoại</td><td style="width:16.34%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">590 G</span></td><td style="width:20.07%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+54 Sát thương</span></td></tr><tr><td style="width:7.84%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">9</td><td style="width:24.39%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Phượng Hỏa Thần Kiếm</td><td style="width:16.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Weapon</span></td><td style="width:14.38%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Thần Thoại</td><td style="width:16.34%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">720 G</span></td><td style="width:20.07%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+65 Sát thương</span></td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">7.3. Giao diện game</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Hệ thống giao diện trong Unity được xây dựng theo phong cách <strong>Dark-Fantasy Obsidian &amp; Gold</strong> thông qua hai lớp tiện ích <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">FantasyUiThemeHelper.cs</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CombatHudStyler.cs</span>, trải dài trên 7 Scene trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EditorBuildSettings.asset</span>:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Màn hình Tải tài nguyên (LoadingScene.unity – LoadingController.cs):</strong> Hiển thị hình nền nghệ thuật toàn màn hình, hiệu ứng tàn lửa bay (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">FloatingEmbersUI</span>), thanh tiến trình phần trăm mượt mà, dòng trạng thái nạp từng nhóm tài nguyên và luân phiên 5 mẹo chơi (<em>Gameplay Tips</em>) mỗi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">2.2 giây</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Màn hình Đăng nhập &amp; Đăng ký (LoginScene.unity – AuthUIController.cs):</strong> Cung cấp 2 thẻ giao diện chuyển đổi mượt mà giữa <em>Đăng nhập chiến binh</em> và <em>Tạo tài khoản mới</em>, hỗ trợ phím <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Tab</span> chuyển ô nhập và phím <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Enter</span> gửi biểu mẫu.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Màn hình Chọn Nhân vật 3D (PickCharacter.unity – CharacterSelectController.cs):</strong> Sân khấu 3D trưng bày 4 chiến binh trên bệ đá phát sáng, cho phép dùng chuột kéo xoay nhân vật 360 độ, xem 4 thanh chỉ số (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">HP</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">DMG</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Speed</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Defense</span>) và đặc kỹ riêng.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>4.</strong>&nbsp;<strong>Màn hình Chọn Bản đồ 3D (PickMap.unity – MapSelectController.cs):</strong> Hiển thị 3 mô hình sa bàn 3D tự động xoay của 3 chiến dịch (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lv1</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lv2</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lv3</span>), tự động đổi bầu trời (<em>Skybox</em>) theo bản đồ đang chọn và hiển thị thông tin Boss, cạm bẫy, độ khó.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>5.</strong>&nbsp;<strong>Giao diện Chiến đấu trong trận (Lv1.unity, Lv2.unity, Lv3.unity):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Góc trên bên trái (StageMissionHUD):</strong> Hiển thị tên màn hiện tại, mục tiêu nhiệm vụ (số quái còn lại hoặc khoảng cách tới cột sáng dẫn đường) và thanh phím tắt điều khiển.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Chính giữa phía trên (BossHpBarHUD):</strong> Thanh máu Boss với hiệu ứng máu trễ (<em>Ghost Damage Fill</em>) và nhấp nháy đỏ cam khi Boss vào pha Cuồng Nộ.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Góc dưới màn hình:</strong> Thanh máu người chơi (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerHealth</span>) tự động đổi màu theo ngưỡng máu (Xanh ngọc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&gt; 50%</span>, Vàng cam <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">25%–50%</span>, Đỏ nhấp nháy <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&lt; 25%</span>) và thẻ hiển thị số Vàng hiện có kèm phím mở cửa hàng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">[B]</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>6.</strong>&nbsp;<strong>Giao diện Cửa hàng Lò Rèn (WeaponShopOverlay):</strong> Bảng lưới 8 thẻ vũ khí có ảnh chụp 3D trực tiếp từ Prefab (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">RenderAllWeaponThumbnails</span>) và thanh mua Bình hồi máu.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>7.</strong>&nbsp;<strong>Màn hình Kết thúc trận đấu (GameOverManager.cs):</strong> Tự động chuyển đổi bảng màu Vàng Kim (<em>CHIẾN THẮNG!</em>) hoặc Đỏ Thẫm (<em>THẤT BẠI</em>), hiển thị 3 ô thống kê trận đấu (<em>Tiến độ màn</em>, <em>Điểm • Vàng</em>, <em>Thời lượng mm:ss</em>) cùng các nút <em>Màn tiếp theo</em>, <em>Chơi lại</em> và <em>Thoát game</em>.</p><p style="text-align:center;margin:10pt 0 3pt 0;"><span style="color:#1d4ed8;background:#eff6ff;font-weight:bold;padding:2pt 4pt;border:1pt dashed #1d4ed8;">[CHÈN HÌNH ẢNH: Màn hình LoadingScene và LoginScene trong Unity]</span></p><p style="text-align:center;font-style:italic;color:#334155;font-size:12pt;margin:2pt 0 12pt 0;">Hình 7.1. Giao diện màn hình Tải tài nguyên (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoadingScene</span>) và màn hình Đăng nhập/Đăng ký (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoginScene</span>).</p><p style="text-align:center;margin:10pt 0 3pt 0;"><span style="color:#1d4ed8;background:#eff6ff;font-weight:bold;padding:2pt 4pt;border:1pt dashed #1d4ed8;">[CHÈN HÌNH ẢNH: Màn hình Chọn Nhân vật 3D (PickCharacter) và Chọn Bản đồ 3D (PickMap)]</span></p><p style="text-align:center;font-style:italic;color:#334155;font-size:12pt;margin:2pt 0 12pt 0;">Hình 7.2. Giao diện sân khấu 3D Chọn Nhân vật (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PickCharacter</span>) và sa bàn 3D Chọn Bản đồ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PickMap</span>).</p><p style="text-align:center;margin:10pt 0 3pt 0;"><span style="color:#1d4ed8;background:#eff6ff;font-weight:bold;padding:2pt 4pt;border:1pt dashed #1d4ed8;">[CHÈN HÌNH ẢNH: Giao diện Combat HUD, Đấu trường Boss và Cửa hàng Lò Rèn trong trận]</span></p><p style="text-align:center;font-style:italic;color:#334155;font-size:12pt;margin:2pt 0 12pt 0;">Hình 7.3. Giao diện chiến đấu trong trận, thanh máu Boss và bảng Cửa hàng Lò Rèn Vanguard.</p><p style="text-align:center;margin:10pt 0 3pt 0;"><span style="color:#1d4ed8;background:#eff6ff;font-weight:bold;padding:2pt 4pt;border:1pt dashed #1d4ed8;">[CHÈN HÌNH ẢNH: Màn hình kết quả Chiến Thắng (Victory) và Thất Bại (Game Over)]</span></p><p style="text-align:center;font-style:italic;color:#334155;font-size:12pt;margin:2pt 0 12pt 0;">Hình 7.4. Giao diện thẻ tổng kết trận đấu khi Chiến thắng và khi Thất bại.</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">7.4. Các chức năng chính và tối ưu hiệu năng giảm giật lag</h2><h3 style="font-family:'Times New Roman',serif;font-size:13pt;color:#1e40af;font-weight:bold;font-style:italic;margin:10pt 0 5pt 0;page-break-after:avoid;">7.4.1. Giải thích chi tiết các chức năng chính trên Game Client</h3><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Chức năng Nạp trước tài nguyên và Chuyển cảnh (GameAssetPreloader &amp; LoadingController):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Nạp sẵn các tài nguyên nặng vào bộ nhớ RAM và biên dịch trước Shader để ngăn chặn hiện tượng giật khựng khung hình khi vừa vào trận.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Khi chuyển cảnh qua <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoadingController.LoadScene()</span>, coroutine <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PreloadAssetsCoroutine</span> duyệt qua danh mục <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CoreManifest</span> gồm 31 tài nguyên bắt buộc (4 Texture UI, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CharacterRosterConfig</span>, 5 Prefab vàng/bình máu, 22 AudioClip BGM/SFX), gọi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Resources.LoadAsync</span>, giải mã trước dữ liệu âm thanh (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">clip.LoadAudioData()</span>), lưu tham chiếu Mesh/Material của các Prefab nhân vật và gọi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShaderVariantCollection.WarmUpProgressively(4)</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Tên Scene đích (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">pendingTargetScene</span>) và danh sách đường dẫn tài nguyên trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CoreManifest</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Bộ nhớ đệm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">assetCache</span> chứa toàn bộ tài nguyên đã sẵn sàng truy xuất tức thì (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">O(1)</span>) và Scene đích được kích hoạt mượt mà ở mốc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">100%</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Chức năng Điều khiển nhân vật, Tấn công và Phòng thủ (PlayerController, PlayerAttack, PlayerCharacterLoader):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Tải mô hình nhân vật người chơi đã chọn, xử lý di chuyển theo hướng camera, căn chỉnh bàn chân bám địa hình, chém combo và đỡ đòn/phản đòn.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerCharacterLoader.ApplySelectedCharacter</span> thay thế mô hình 3D, gán các chỉ số từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CharacterProfile</span> và dùng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponGripAligner.AlignWeaponToHand</span> để tính toán hình học xương bàn tay, đặt chuôi vũ khí nghiêng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">12 độ</span> khớp vào lòng bàn tay nhân vật.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerController</span> đọc tổ hợp phím <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WASD</span>, tính vector di chuyển theo góc xoay của <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ThirdPersonCamera</span>, bật trạng thái <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IsBlocking</span> khi giữ Chuột Phải và kiểm tra cửa sổ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IsPerfectParryWindow</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0.28s</span>).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerAttack</span> sử dụng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Physics.OverlapBoxNonAlloc</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Physics.OverlapSphereNonAlloc</span> để quét va chạm lưỡi kiếm với quái vật mà không sinh rác bộ nhớ, kích hoạt hiệu ứng vệt chém nguyên tố (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponElementalVfx</span>) và chữ sát thương nổi.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Tín hiệu bàn phím (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WASD</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Tab</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Q</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">B</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">E</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Esc</span>) và chuột (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LMB</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">RMB</span>, di chuyển chuột).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Chuyển động nhân vật mượt mà trên địa hình, sát thương và hiệu ứng đẩy lùi gây lên quái vật, cùng các sự kiện <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">block_hit</span> / <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">perfect_parry</span> gửi về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Chức năng AI Quái vật và Điều phối Màn chơi (StageManager, OrcEnemyAI, EnemyHealth):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Sinh các đợt quái theo 3 khu vực của bản đồ, điều khiển quái tìm đường truy đuổi người chơi, né vật cản, tấn công và xử lý rơi vật phẩm khi chết.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StageManager.SpawnOrc</span> tìm điểm hợp lệ trên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NavMesh</span> quanh tâm đấu trường, khởi tạo Prefab quái, nhân chỉ số máu và sát thương theo hệ số của bản đồ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">enemyHpMultiplier</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">enemyDamageMultiplier</span>).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OrcEnemyAI</span> sử dụng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NavMeshAgent</span> kết hợp thuật toán lái tia tránh vật cản dự phòng (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ChooseClearSteeringDirection</span> quét 6 góc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">±35°</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">±65°</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">±95°</span>) và thuật toán tách bầy (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EnforceSeparation</span>) để các quái không dẫm đè lên nhau.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Khi máu quái về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EnemyHealth.Die()</span> cộng điểm vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ScoreManager</span>, gọi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldPickup.SpawnGoldBurst</span>, tính xác suất <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">22%</span> rơi bình máu, gửi sự kiện <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">enemy_killed</span> (và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">boss_killed</span> nếu là Boss) tới <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Vị trí hiện tại của người chơi (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">playerTransform.position</span>) và sát thương nhận từ vũ khí người chơi.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Hành vi chiến đấu thông minh của quái/Boss, vật phẩm rơi ra trên bản đồ và tín hiệu chuyển màn/chiến thắng.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>4.</strong>&nbsp;<strong>Chức năng Cửa hàng Lò Rèn và Trang bị Vũ khí (WeaponShopManager, WeaponUpgradeConfigSO):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Cho phép người chơi tiêu Vàng nhặt được trong trận để mua Bình hồi máu hoặc rèn và trang bị 8 loại vũ khí cấp cao.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Khi mở cửa hàng, hệ thống tạm dừng thời gian trận đấu (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Time.timeScale = 0f</span>), dựng một studio ảo (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TempWeaponThumbnailStudio</span>) ở tọa độ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Y = -650</span> để chụp ảnh 2D (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">128x128</span>) từ mô hình 3D của 8 vũ khí và lưu vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">thumbnailCache</span>. Khi người chơi bấm mua, hệ thống gọi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ScoreManager.Instance.TrySpendGold(price)</span>, tháo vũ khí cũ trên xương tay phải, gắn Prefab vũ khí mới kèm hào quang nguyên tố <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponElementalVfx</span>, cộng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">bonusDamage</span> vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerAttack</span> và gọi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager.TrackWeaponPurchased(price)</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Lượng Vàng hiện có trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ScoreManager.gold</span> và thao tác chọn mua của người chơi.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Nhân vật được hồi máu hoặc trang bị vũ khí mới với sát thương cao hơn, đồng thời ghi nhận giao dịch về Backend.</p><h3 style="font-family:'Times New Roman',serif;font-size:13pt;color:#1e40af;font-weight:bold;font-style:italic;margin:10pt 0 5pt 0;page-break-after:avoid;">7.4.2. Các giải pháp kỹ thuật tối ưu hiệu năng và giảm giật lag (Lag Optimization)</h3><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Để khắc phục triệt để hiện tượng tụt FPS và giật lag trên các bản đồ 3D rộng có nhiều cây cối, ánh sáng và hiệu ứng hạt, nhóm đã triển khai 5 nhóm kỹ thuật tối ưu hóa trực tiếp trong mã nguồn:</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 7.2. Tổng hợp các kỹ thuật tối ưu hóa giảm giật lag đã triển khai trên Unity Client</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10.5pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:5.73%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">STT</th><th style="width:19.4%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Hạng mục tối ưu</th><th style="width:22.65%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">File mã nguồn thực hiện</th><th style="width:27.27%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Kỹ thuật triển khai chi tiết</th><th style="width:24.95%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Hiệu quả thực tế</th></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">1</td><td style="width:19.4%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Tối ưu cấu hình Đồ họa &amp; Terrain lúc Runtime</strong></td><td style="width:22.65%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StageManager.​cs</span><br/>(<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ApplyRuntimePerformanceOptimizations</span>)</td><td style="width:27.27%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">- Khóa <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Application.​targetFrameRate = 60</span>, tắt <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">vSyncCount = 0</span>.<br/>- Giới hạn tầm nhìn camera <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">farClipPlane = 240f</span> và khoảng cách đổ bóng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">shadowDistance = 38f</span>.<br/>- Bật <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">terrain.​drawInstanced = true</span> (GPU Instancing cho địa hình), đặt <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">heightmapPixelError = 16f</span>, giảm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">treeDistance = 140f</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">treeBillboardDistance = 35f</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">detailObjectDistance = 45f</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">detailObjectDensity = 0.65f</span> và tắt đổ bóng địa hình (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShadowCastingMode.​Off</span>).</td><td style="width:24.95%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Giảm mạnh số lượng Draw Calls và tải GPU khi nhìn bao quát rừng cây, núi tuyết và pháo đài dung nham.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">2</td><td style="width:19.4%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Cắt giảm hiển thị theo khoảng cách (Distance Culling)</strong></td><td style="width:22.65%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">MapAtmosphereVfx.​cs</span>,<br/><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EnemyHealth.​cs</span>,<br/><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldPickup.cs</span>,<br/><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">HealthPickup.​cs</span>,<br/><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CampfireCheckpoint.​cs</span></td><td style="width:27.27%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">- Tự động tắt các đèn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Point Light</span> khi cách người chơi quá <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">26m–42m</span> và dừng phát hạt <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ParticleSystem</span> khi cách quá <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">26m–64m</span>.<br/>- Thanh máu nổi 3D trên đầu quái (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EnemyOverheadHpBar</span>) chỉ bật khi quái ở trong bán kính <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">18m</span>, bị mất máu hoặc đang bị khóa mục tiêu.<br/>- Chia sẻ chung Mesh và Material (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sharedBarQuadMesh</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SharedBeamMats</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SharedRingMats</span>) kết hợp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">MaterialPropertyBlock</span> để gộp Batch.</td><td style="width:24.95%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Loại bỏ chi phí tính toán ánh sáng thời gian thực và hiệu ứng hạt ở các khu vực người chơi chưa đi tới.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">3</td><td style="width:19.4%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Hồ tái sử dụng đối tượng (Object Pooling)</strong></td><td style="width:22.65%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CombatVfxManager.​cs</span>,<br/><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameAudioManager.​cs</span></td><td style="width:27.27%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">- Sử dụng Object Pool giới hạn số lượng tối đa cho hiệu ứng máu (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">MaxActivePooledBloodHits = 12</span>), hiệu ứng nổ nguyên tố (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">MaxActivePooledElementalHits = 10</span>), vệt chém (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">MaxActivePooledSlashArcs = 6</span>) và đèn chớp (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">MaxConcurrentFlashLights = 3</span>).<br/>- Sử dụng mảng xoay vòng 6 nguồn âm thanh <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sfxPool = new AudioSource[6]</span> thay vì tạo/hủy <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">AudioSource</span> liên tục.</td><td style="width:24.95%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Triệt tiêu hiện tượng khựng hình do khởi tạo (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Instantiate</span>) và hủy (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Destroy</span>) đối tượng liên tục khi giao tranh đông quái.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:19.4%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Chống cấp phát rác bộ nhớ (Zero-GC Physics &amp; Caching)</strong></td><td style="width:22.65%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerAttack.​cs</span>,<br/><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerController.​cs</span>,<br/><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OrcEnemyAI.cs</span>,<br/><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StageManager.​cs</span></td><td style="width:27.27%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">- Sử dụng bộ đệm cố định với <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Physics.​OverlapBoxNonAlloc</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Physics.​OverlapSphereNonAlloc</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Physics.​RaycastNonAlloc</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">hitBuffer</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">groundHitBuffer</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TerrainHitBuffer</span>).<br/>- Tái sử dụng đối tượng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WaitForSeconds</span> và chỉ cập nhật đường đi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NavMeshAgent.​SetDestination</span> mỗi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0.15 giây</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">DestinationUpdateInterval</span>) thay vì mỗi khung hình.</td><td style="width:24.95%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Ngăn chặn Garbage Collector (GC) quét bộ nhớ đột ngột gây giật khung hình (<em>GC Spike</em>).</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">5</td><td style="width:19.4%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Nạp trước tài nguyên &amp; Gom lô mạng (Preloading &amp; Network Batching)</strong></td><td style="width:22.65%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameAssetPreloader.​cs</span>,<br/><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager.​cs</span></td><td style="width:27.27%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">- Nạp bất đồng bộ 31 tài nguyên và làm ấm Shader ở <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoadingScene</span> (chia lát cắt thời gian <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0.008s/frame</span>).<br/>- Gom nhóm sự kiện Telemetry gửi theo lô mỗi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">1.8 giây</span> bằng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">reusableBatchDto</span>.</td><td style="width:24.95%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Không bị khựng game lần đầu khi phát âm thanh/hiệu ứng mới hoặc khi gửi sự kiện lên Server.</td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">7.5. Tích hợp hệ thống Telemetry</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Hệ thống Telemetry được tích hợp xuyên suốt vào các kịch bản Gameplay thông qua mẫu thiết kế <strong>Singleton (TelemetryManager.Instance)</strong>. Bảng 7.3 đối chiếu chính xác vị trí từng lệnh gọi thu thập sự kiện trong mã nguồn Unity:</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 7.3. Bảng ánh xạ các điểm chạm tích hợp Telemetry trong mã nguồn Unity Client</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10.5pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:5.73%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">STT</th><th style="width:22.19%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Script kích hoạt</th><th style="width:23.97%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Phương thức gọi trong Script</th><th style="width:27.86%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Hàm của <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager</span> được gọi</th><th style="width:20.24%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Sự kiện sinh ra (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EventType</span>)</th></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">1</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">AuthApiClient.​cs</span> &amp; <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SendAuthRequestCoroutine(​)​</span> → <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StartNewSession(​)​</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackEvent(​&quot;login&quot;,​ playerId)</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">login</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">2</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StartNewSession(​)​</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackEvent(​&quot;game_​start&quot;)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">game_start</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">3</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StageManager.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BeginStage1Routine(​)​</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackLevelStart(​MapLevel)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_start</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StageManager.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">HandleBossDied(​)​</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackLevelComplete(​MapLevel)​</span> &amp; <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackGameEnded(​&quot;Win&quot;)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_​complete</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">game_exit</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">5</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerHealth.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Die()</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackPlayerDied(​)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">player_dead</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_failed</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">game_exit</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">6</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameOverManager.​cs</span> &amp; <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">QuitGame()</span> / <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OnApplicationQuit(​)​</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackGameEnded(​&quot;Quit&quot;)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">game_exit</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">7</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EnemyHealth.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Die()</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackEnemyKilled(​scoreValue)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">enemy_killed</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">8</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EnemyHealth.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Die()</span> (khi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">isBoss == true</span>)</td><td style="width:27.86%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackBossKilled(​CurrentLevel)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">boss_killed</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">9</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldPickup.cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Collect()</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackGoldCollected(​goldAmount)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">gold_​collected</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">10</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OrcWeaponHitbox.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CheckHit()</span> (khi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IsBlocking &amp;&amp; !perfectParry</span>)</td><td style="width:27.86%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackBlockHit(​blockedAmount)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">block_hit</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">11</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OrcWeaponHitbox.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CheckHit()</span> (khi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IsBlocking &amp;&amp; perfectParry</span>)</td><td style="width:27.86%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackPerfectParry(​CurrentLevel)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">perfect_parry</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">12</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrapHazard.cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TriggerTrap()</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackTrapHit(​damage)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">trap_hit</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">13</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponShopManager.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OpenShop()</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackShopOpened(​level)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">shop_opened</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">14</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponShopManager.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OnWeaponButtonClicked(​)​</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackWeaponPurchased(​item.​price)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">weapon_​purchased</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">15</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponShopManager.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OnBuyPotionClicked(​)​</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackPotionPurchased(​potionPrice)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">potion_​purchased</span></td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">16</td><td style="width:22.19%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CampfireCheckpoint.​cs</span> &amp; <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">HealthPickup.​cs</span></td><td style="width:23.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ActivateCheckpoint(​)​</span> / <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Collect()</span></td><td style="width:27.86%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackCheckpointReached(​level)​</span> / <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrackItemPickup(​healAmount)​</span></td><td style="width:20.24%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">checkpoint_​reached</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">item_pickup</span></td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">7.6. Gửi dữ liệu từ Unity lên API</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Quá trình truyền thông mạng từ Unity Client lên Backend ASP.NET Core Web API được chia thành 3 lớp chuyên trách trong thư mục <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Assets/DucThanh/Scripts/Networking/</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Telemetry/</span>:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Lớp cấu hình kết nối ApiConfig (AuthApiClient.cs):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Quản lý các hằng số địa chỉ máy chủ gồm:</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LOCAL_HTTPS_URL = &quot;https://localhost:7013&quot;</span></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LOCAL_HTTP_URL = &quot;http://localhost:5295&quot;</span></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">DEVTUNNEL_URL = &quot;https://sjf1zkj0-7013.asse.devtunnels.ms&quot;</span></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Cho phép ghi đè linh hoạt qua <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerPrefs.GetString(&quot;ApiBaseUrl&quot;, DEFAULT_BASE_URL)</span> hoặc qua trường <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">[SerializeField] private string baseUrl</span> trên Inspector.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Phương thức <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ApiConfig.ConfigureRequest(UnityWebRequest request, string url)</span> tự động xử lý chứng chỉ SSL cục bộ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LocalhostCertificateHandler</span>) và thêm header <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">X-Tunnel-Skip-AntiPhishing-Page: true</span> để request JSON từ Unity không bị chặn bởi trang xác nhận của Microsoft Dev Tunnels.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Lớp giao tiếp xác thực AuthApiClient (AuthApiClient.cs):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Đóng gói dữ liệu đăng ký/đăng nhập thành chuỗi JSON bằng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">JsonUtility.ToJson(payload)</span>, đính kèm vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">UploadHandlerRaw(Encoding.UTF8.GetBytes(json))</span> với header <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Content-Type: application/json</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">timeout = 15 giây</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Khi đăng nhập thành công (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">HTTP 200 OK</span>), lớp này lưu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerId</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerName</span> và cờ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PendingLoginEvent = 1</span> vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerPrefs</span>, đồng thời xóa <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SessionId</span> cũ để chuẩn bị cho phiên chơi mới.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Lớp quản lý phiên SessionApiClient (SessionApiClient.cs) và TelemetryManager:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Khi vào trận, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SessionApiClient.StartSession</span> gửi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">POST /api/Sessions/start</span> để nhận <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionId</span> từ SQL Server và lưu vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerPrefs.SetString(&quot;SessionId&quot;, ...)</span>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Trong trận, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager.ProcessPendingEventsCoroutine</span> đóng gói danh sách sự kiện đang chờ và gửi qua <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">POST /api/Events/batch</span> (với <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">timeout = 10 giây</span>).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Khi kết thúc trận, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager.TrackGameEnded</span> đẩy nốt sự kiện <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">game_exit</span> rồi gọi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionApiClient.EndSession(sessionResult)</span> gửi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PUT /api/Sessions/{id}/end</span> để cập nhật <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EndTime</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Result</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;Win&quot;</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;Lose&quot;</span> hoặc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;Quit&quot;</span>).</p><hr style="border:none;border-bottom:1pt solid #cbd5e1;margin:12pt 0;"/><h1 style="font-family:'Times New Roman',serif;font-size:16pt;color:#1e3a8a;font-weight:bold;margin:16pt 0 8pt 0;page-break-after:avoid;">CHƯƠNG 8. XÂY DỰNG DASHBOARD</h1><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">8.1. Tổng quan Dashboard</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Phân hệ <strong>Web Dashboard</strong> có tên giao diện là <strong>VANGUARD // TELEMETRY</strong>, được xây dựng trong tệp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Backend/GameTelemetryAPI/wwwroot/index.html</span>. Đây là ứng dụng web đơn trang (<em>Single-Page Analytics Dashboard</em>) giao tiếp trực tiếp với các REST API của <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">AnalyticsController</span> để hiển thị bức tranh toàn diện về hành vi người chơi.</p><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;"><strong>Đặc điểm kỹ thuật nổi bật của Dashboard:</strong></p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Đồng bộ dữ liệu song song và thời gian thực:</strong> Hàm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">loadAllDashboardData()</span> sử dụng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Promise.all([...])</span> để gọi đồng thời 6 Endpoint thống kê (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/overview</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/levels</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/economy</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/combat</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/sessions-by-date</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/recent-sessions</span>), giúp toàn bộ trang được làm mới chỉ trong một chu kỳ mạng. Hệ thống tự động cập nhật dữ liệu định kỳ mỗi <strong>12 giây</strong> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">setInterval(..., 12000)</span>).</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Giám sát trạng thái kết nối trực tiếp:</strong> Góc phải thanh tiêu đề hiển thị đèn tín hiệu trạng thái kết nối cơ sở dữ liệu: màu xanh lá <strong>SQL LIVE</strong> kèm giờ đồng bộ gần nhất khi API phản hồi thành công, hoặc chuyển sang màu đỏ <strong>OFFLINE</strong> nếu mất kết nối tới máy chủ.</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">8.2. Thiết kế giao diện</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Giao diện Dashboard được thiết kế đồng bộ với phong cách mỹ thuật <strong>Dark-Fantasy HUD</strong> của trò chơi Unity (nền tối <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#080b12</span>, thẻ bo góc viền vàng kim <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#e8b84b</span>, phông chữ tiêu đề <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Cinzel</span>, phông chữ nội dung <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Inter</span> và phông chữ số liệu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">JetBrains Mono</span>). Bố cục màn hình được chia thành <strong>5 khu vực chức năng (Header + Filter Bar + 4 Bands)</strong> rõ ràng:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Thanh tiêu đề &amp; Công cụ điều hành (Top Header):</strong> Hiển thị tên hệ thống <em>VANGUARD // TELEMETRY</em>, đèn trạng thái <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SQL LIVE</span>, nút mở <strong>Bot Giả lập</strong>, nút <strong>Xuất CSV</strong> và nút <strong>Làm mới</strong>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Thanh bộ lọc gọn nhẹ (Compact Filter Bar):</strong> Cho phép lọc nhanh theo mốc thời gian định sẵn, theo khoảng ngày tùy chỉnh và theo từng bản đồ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 1..3</span>).</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Dải 1 (Band 1 – 5 Core KPI Cards):</strong> Hàng 5 thẻ chỉ số hiệu suất cốt lõi.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>4.</strong>&nbsp;<strong>Dải 2 (Band 2 – Level Funnel &amp; Daily Trend):</strong> Biểu đồ cột so sánh tỷ lệ Hoàn thành/Thất bại theo Level (kèm 3 thẻ tóm tắt từng Level) và Biểu đồ đường xu hướng số phiên chơi theo ngày.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>5.</strong>&nbsp;<strong>Dải 3 (Band 3 – Core Combat &amp; Blacksmith Shop):</strong> Khung phân tích 3 nhóm chỉ số chiến đấu cốt lõi và Biểu đồ thanh ngang thống kê lượt mua 8 loại vũ khí tại Cửa hàng Lò Rèn.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>6.</strong>&nbsp;<strong>Dải 4 (Band 4 – Recent Sessions Log &amp; Modals):</strong> Bảng nhật ký các phiên chơi gần đây có ô tìm kiếm nhanh, bộ lọc trạng thái Thắng/Thua và khả năng nhấp vào từng phiên để mở cửa sổ <strong>Chi tiết dòng thời gian sự kiện (Session Event Timeline Modal)</strong>.</p><p style="text-align:center;margin:10pt 0 3pt 0;"><span style="color:#1d4ed8;background:#eff6ff;font-weight:bold;padding:2pt 4pt;border:1pt dashed #1d4ed8;">[CHÈN HÌNH ẢNH: Giao diện tổng thể Web Dashboard VANGUARD // TELEMETRY trên trình duyệt]</span></p><p style="text-align:center;font-style:italic;color:#334155;font-size:12pt;margin:2pt 0 12pt 0;">Hình 8.1. Giao diện tổng thể của Web Dashboard phân tích dữ liệu người chơi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">VANGUARD // TELEMETRY</span>.</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">8.3. Các chỉ số thống kê</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Đáp ứng và vượt yêu cầu bắt buộc của đề tài (<em>&quot;Dashboard hiển thị tối thiểu 5 chỉ số&quot;</em>), giao diện Dashboard hiển thị <strong>5 thẻ KPI cốt lõi</strong> ở Dải 1 cùng <strong>5 nhóm chỉ số chuyên sâu</strong> về Chiến đấu và Kinh tế ở Dải 3:</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 8.1. Mô tả chi tiết các chỉ số thống kê hiển thị trên Dashboard</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10.5pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:5.73%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">STT</th><th style="width:13.41%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Tên chỉ số trên Dashboard</th><th style="width:25.33%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Nguồn API &amp; Trường dữ liệu</th><th style="width:29.54%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Công thức / Cách tính toán</th><th style="width:26%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Ý nghĩa phân tích đối với nhà phát triển</th></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">1</td><td style="width:13.41%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Phiên Chơi &amp; Tổng Tài Khoản</strong></td><td style="width:25.33%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​overview</span><br/>(<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalSessions</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalPlayers</span>)</td><td style="width:29.54%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đếm tổng số bản ghi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span> và số <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerId</span> duy nhất thỏa bộ lọc.</td><td style="width:26%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đo lường quy mô người chơi và mức độ gắn kết (<em>Engagement</em>) với trò chơi.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">2</td><td style="width:13.41%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Thời Lượng Trung Bình</strong></td><td style="width:25.33%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​overview</span><br/>(<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">averageSessionDurationMinutes</span>)</td><td style="width:29.54%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">AvgDuration = (1 / N) × ∑(EndTime - StartTime) (tính bằng phút trên các phiên đã kết thúc).</td><td style="width:26%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Cho biết trung bình một lượt chơi kéo dài bao lâu, phát hiện tình trạng thoát game quá sớm.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">3</td><td style="width:13.41%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Tỷ Lệ Thắng (Win Rate)</strong></td><td style="width:25.33%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​overview</span><br/>(<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">winRatePercent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalWins</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalLosses</span>)</td><td style="width:29.54%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">WinRate = [TotalWins / (TotalWins + TotalLosses)] × 100%.</td><td style="width:26%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đánh giá độ khó tổng thể của trò chơi đang nghiêng về phía người chơi hay quái vật.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:13.41%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Level Hay Thất Bại Nhất</strong></td><td style="width:25.33%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​levels</span><br/>(Hàm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">findHardestLevel</span>)</td><td style="width:29.54%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Chọn Level có số lượt tử trận (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">deaths</span>) cao nhất; nếu bằng nhau thì chọn Level có <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">completionRatePercent</span> thấp hơn.</td><td style="width:26%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Cảnh báo tức thì bản đồ nào đang gây khó khăn lớn nhất cho người chơi.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">5</td><td style="width:13.41%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Kinh Tế Vàng (Tỷ lệ tiêu vàng)</strong></td><td style="width:25.33%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​economy</span> &amp; <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/overview</span><br/>(<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">spendRatioPercent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalGoldSpent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalGoldEarned</span>)</td><td style="width:29.54%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">SpendRatio = (​TotalGoldSpent / TotalGoldCollected)​ × 100%.</td><td style="width:26%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đánh giá sự cân bằng giữa nguồn cung vàng (diệt quái) và nhu cầu tiêu vàng (mua vũ khí/bình máu).</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">6</td><td style="width:13.41%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Quái &amp; Boss Hạ Gục</strong></td><td style="width:25.33%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​combat</span><br/>(<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalEnemyKills</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">bossKills</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">bossClearRatePercent</span>)</td><td style="width:29.54%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Tổng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EnemiesKilled</span>, tổng số phiên có <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BossKilled = 1</span> và tỷ lệ hạ Boss trên tổng số phiên.</td><td style="width:26%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đo lường nhịp độ giao tranh và tỷ lệ người chơi đi tới được mục tiêu cuối cùng của bản đồ.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">7</td><td style="width:13.41%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Phòng Thủ (Block &amp; Parry Rate)</strong></td><td style="width:25.33%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​combat</span><br/>(<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">blockHits</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">perfectParries</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">parryMasteryPercent</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalBlockedDamage</span>)</td><td style="width:29.54%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">ParryRate = [PerfectParries / (BlockHits + PerfectParries)​] × 100%.</td><td style="width:26%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đánh giá mức độ thành thạo cơ chế kỹ năng cốt lõi (Chuột Phải đỡ đòn &amp; phản đòn) của người chơi.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">8</td><td style="width:13.41%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Thiệt Hại Bẫy Gai</strong></td><td style="width:25.33%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Analytics/​combat</span><br/>(<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">trapHits</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">totalTrapDamage</span>)</td><td style="width:29.54%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Tổng số lần dính bẫy <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SUM(TrapHits)</span> và tổng máu mất <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SUM(​TrapDamage)​</span>.</td><td style="width:26%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đánh giá hiệu quả của hệ thống cạm bẫy môi trường tại Khu vực 2.</td></tr></table><p style="text-align:center;margin:10pt 0 3pt 0;"><span style="color:#1d4ed8;background:#eff6ff;font-weight:bold;padding:2pt 4pt;border:1pt dashed #1d4ed8;">[CHÈN HÌNH ẢNH: Cận cảnh 5 thẻ KPI cốt lõi và khung thống kê Chiến Đấu Cốt Lõi trên Dashboard]</span></p><p style="text-align:center;font-style:italic;color:#334155;font-size:12pt;margin:2pt 0 12pt 0;">Hình 8.2. Hiển thị 5 thẻ KPI cốt lõi và bảng phân tích Chiến đấu cốt lõi trên Dashboard.</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">8.4. Biểu đồ phân tích</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Dashboard sử dụng thư viện <strong>Chart.js 4.4.1</strong> để dựng 3 biểu đồ trực quan hóa dữ liệu:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Biểu đồ cột nhóm: Tỷ lệ Hoàn thành &amp; Thất bại theo Level (levelFunnelChart):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> So sánh trực quan 3 đại lượng: Số lượt <strong>Bắt đầu</strong> (cột xanh lam <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#38bdf8</span>), Số lượt <strong>Hoàn thành</strong> (cột xanh lá <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#22c55e</span>) và Số lượt <strong>Thất bại / Tử trận</strong> (cột đỏ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#ef4444</span>) trên cả 3 bản đồ chiến dịch.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Hàm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">renderLevelStats(levels)</span> nhận mảng dữ liệu từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Analytics/levels</span>, dựng biểu đồ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">type: &apos;bar&apos;</span> và đồng thời sinh 3 thẻ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">stage-mini-pill</span> bên dưới hiển thị tỷ lệ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">% Qua màn</span> kèm nhãn đỏ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Hay thất bại nhất</span> cho Level có nhiều lượt tử trận nhất.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Biểu đồ đường: Xu hướng Phiên chơi theo Ngày (sessionsDateChart):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Theo dõi biến động lưu lượng phiên chơi theo từng ngày.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Hàm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">renderSessionsTrend(dates)</span> nhận dữ liệu từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Analytics/sessions-by-date</span>, dựng biểu đồ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">type: &apos;line&apos;</span> có tô vùng mờ màu vàng kim dưới đường biểu diễn (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">fill: true</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">tension: 0.3</span>).</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Biểu đồ thanh ngang: Độ phổ biến Vũ khí tại Cửa hàng Lò Rèn (weaponPopularityChart):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Thống kê số lượt mua và tổng vàng chi tiêu cho từng loại vũ khí trong 8 vũ khí của cửa hàng (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">75 G</span> – <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">720 G</span>).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Hàm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">renderEconomySection(econ)</span> nhận dữ liệu từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Analytics/economy</span>, dựng biểu đồ thanh ngang (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">indexAxis: &apos;y&apos;</span>) trong đó màu sắc của mỗi thanh tự động ánh xạ theo bậc phẩm chất (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">RARITY_COLOR_MAP</span>: Hiếm – Xanh lam, Sử Thi – Tím, Huyền Thoại – Cam, Thần Thoại – Vàng kim). Khi di chuột vào từng thanh, Tooltip hiển thị đầy đủ: <em>Bậc phẩm chất • +Sát thương • Số lần mua • Tổng vàng đã chi</em>.</p><p style="text-align:center;margin:10pt 0 3pt 0;"><span style="color:#1d4ed8;background:#eff6ff;font-weight:bold;padding:2pt 4pt;border:1pt dashed #1d4ed8;">[CHÈN HÌNH ẢNH: Ba biểu đồ phân tích Level Funnel, Xu hướng Phiên chơi theo Ngày và Cửa hàng Lò Rèn]</span></p><p style="text-align:center;font-style:italic;color:#334155;font-size:12pt;margin:2pt 0 12pt 0;">Hình 8.3. Các biểu đồ phân tích tỷ lệ qua màn theo Level, xu hướng phiên chơi theo ngày và thống kê mua vũ khí.</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">8.5. Bộ lọc thời gian</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Chức năng Bộ lọc thời gian được thiết kế ở phía bên trái của thanh Filter Bar:</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Cho phép nhà phân tích khoanh vùng dữ liệu thống kê theo một giai đoạn thời gian cụ thể (ví dụ: so sánh dữ liệu trước và sau khi cập nhật cân bằng độ khó).</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Người dùng có thể nhấp vào 4 nút Preset nhanh (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">setTimePreset</span>): <strong>Tất cả (all)</strong>, <strong>Hôm nay (today)</strong>, <strong>7 ngày (7d)</strong>, <strong>30 ngày (30d)</strong> hoặc chọn trực tiếp trên 2 ô lịch <strong>Từ ngày (filterFromDate)</strong> – <strong>Đến ngày (filterToDate)</strong>.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Hàm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">buildFilterQuery()</span> tự động đóng gói giá trị ngày thành chuỗi truy vấn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">?from=YYYY-MM-DD&amp;to=YYYY-MM-DD</span> gửi lên các API của <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">AnalyticsController</span>. Tại Backend, hàm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">FilterSessions</span> lọc các phiên có <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StartTime &gt;= from.Date</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StartTime &lt; to.Date.AddDays(1)</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Mốc preset hoặc ngày bắt đầu / ngày kết thúc do người dùng chọn.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Toàn bộ 5 thẻ KPI, 3 biểu đồ, khung chiến đấu và bảng phiên chơi gần đây được tính toán lại tức thì theo đúng khoảng thời gian đã chọn.</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">8.6. Bộ lọc Level và công cụ tra cứu phiên chơi</h2><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Chức năng Bộ lọc theo Level (filterLevelSelect):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Tách riêng số liệu thống kê của một bản đồ chiến dịch cụ thể (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 1: Rừng Orc &amp; Mỏ Vàng</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 2: Cao Nguyên Băng Tuyết</span>, hoặc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 3: Pháo Đài Dung Nham</span>).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Khi người dùng chọn một Level từ danh sách thả xuống, tham số <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&amp;level=1</span> (hoặc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">2</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">3</span>) được truyền đồng loạt vào 6 API thống kê.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> Mã <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LevelId</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;&quot;</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;1&quot;</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;2&quot;</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;3&quot;</span>).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Các chỉ số tỷ lệ thắng, thời lượng chơi, số quái hạ gục, số lần dính bẫy và lượt mua vũ khí chỉ phản ánh đúng bản đồ đang chọn.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Chức năng Tra cứu Nhật ký và Xem Dòng thời gian Phiên chơi (inspectSession):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dùng để làm gì:</strong> Xem lại chi tiết từng bước hành động của một người chơi trong một phiên chơi cụ thể.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hoạt động như thế nào:</strong> Bảng <em>Nhật ký phiên chơi gần đây</em> hỗ trợ lọc tức thì theo tên người chơi / mã <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#ID</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionSearchInput</span>) và theo kết quả <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Thắng / Thua / Khác</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionStatusFilter</span>). Khi nhấp vào một dòng phiên chơi bất kỳ, hàm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">inspectSession(sessionId)</span> mở cửa sổ Modal và gọi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET /api/Analytics/sessions/{sessionId}/events</span> để dựng danh sách dòng thời gian theo từng mốc giây (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+0s</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+1.8s</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+15.4s</span>...).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Dữ liệu đầu vào:</strong> <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionId</span> của dòng phiên chơi được nhấp chuột.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kết quả đầu ra:</strong> Cửa sổ Modal hiển thị 4 ô tóm tắt (<em>Kết quả</em>, <em>Vàng nhặt/tiêu</em>, <em>Quái hạ gục</em>, <em>Perfect Parry</em>) và danh sách Timeline chi tiết từng sự kiện kèm biểu tượng màu sắc trực quan.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Chức năng Giả lập Bot kiểm thử (runBotSimulation) và Xuất báo cáo CSV (exportTelemetryCsv):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bot Giả lập:</strong> Cho phép chọn 1 trong 3 kịch bản trận đấu chuẩn (<em>Level 1 Thắng</em>, <em>Level 2 Thua vì Bẫy Gai</em>, <em>Level 3 Cao thủ Parry Thắng</em>) để tự động gọi chuỗi API Đăng ký/Đăng nhập → Mở Session → Gửi từng Event → Đóng Session và hiển thị nhật ký trực tiếp trên cửa sổ Terminal của Dashboard.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Xuất CSV:</strong> Kết xuất danh sách phiên chơi đang hiển thị ra tệp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Vanguard_Telemetry_Sessions_YYYY-MM-DD.csv</span> có mã BOM UTF-8 (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">\uFEFF</span>) hiển thị chuẩn tiếng Việt trên Microsoft Excel.</p><p style="text-align:center;margin:10pt 0 3pt 0;"><span style="color:#1d4ed8;background:#eff6ff;font-weight:bold;padding:2pt 4pt;border:1pt dashed #1d4ed8;">[CHÈN HÌNH ẢNH: Cửa sổ Modal Chi tiết Dòng thời gian Phiên chơi (Session Timeline) và Modal Bot Giả lập]</span></p><p style="text-align:center;font-style:italic;color:#334155;font-size:12pt;margin:2pt 0 12pt 0;">Hình 8.4. Cửa sổ xem dòng thời gian sự kiện chi tiết của một phiên chơi và công cụ Giả lập trận đấu kiểm thử.</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">8.7. Phân tích hành vi người chơi từ dữ liệu thu thập được</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Dựa trên <strong>dữ liệu thực tế đang lưu trữ trong cơ sở dữ liệu GameTelemetryDB trên máy chủ SEECONCAC\SQLEXPRESS</strong> tại thời điểm khảo sát (gồm <strong>11 tài khoản người chơi</strong>, <strong>19 phiên chơi</strong>, <strong>228 bản ghi sự kiện cột mốc</strong> và <strong>3 giao dịch mua vũ khí</strong>), nhóm rút ra được các phân tích thực nghiệm quan trọng về hành vi người chơi như sau:</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 8.2. Tổng hợp số liệu thực tế trích xuất từ GameTelemetryDB</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:11pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:14.74%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Nhóm chỉ số thực tế trong CSDL</th><th style="width:20.93%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Số liệu ghi nhận</th><th style="width:64.33%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Chi tiết phân rã thực tế từ SQL Server</th></tr><tr><td style="width:14.74%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Tổng số tài khoản người chơi (Players)</strong></td><td style="width:20.93%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>11 tài khoản</strong></td><td style="width:64.33%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đã đăng ký và tham gia các phiên chơi từ ngày <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">30/10/2026</span> đến <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">21/11/2026</span>.</td></tr><tr><td style="width:14.74%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Tổng số phiên chơi (​GameSessions)​</strong></td><td style="width:20.93%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>19 phiên</strong></td><td style="width:64.33%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">- <strong>Thắng (Win / Victory):</strong> 6 phiên (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">31.6%</span> tổng số phiên; đạt <strong>50.0% Win Rate</strong> trên 12 phiên phân định Thắng/Thua).<br/>- <strong>Thua (Lose):</strong> 6 phiên (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">31.6%</span>).<br/>- <strong>Thoát giữa chừng / Đang mở (Quit / NULL):</strong> 7 phiên (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">36.8%</span>).</td></tr><tr><td style="width:14.74%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Phân bổ phiên chơi theo Bản đồ (LevelId)</strong></td><td style="width:20.93%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>18 phiên có Level</strong></td><td style="width:64.33%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">- <strong>Level 1 (Rừng Orc &amp; Mỏ Vàng):</strong> 8 phiên (5 phiên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Quit</span>, 2 phiên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lose</span>, 1 phiên chưa đóng).<br/>- <strong>Level 2 (Cao Nguyên Băng Tuyết):</strong> 5 phiên (3 phiên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Victory</span>, 2 phiên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lose</span>).<br/>- <strong>Level 3 (Pháo Đài Dung Nham):</strong> 5 phiên (3 phiên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Win</span>, 1 phiên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lose</span>, 1 phiên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Quit</span>).</td></tr><tr><td style="width:14.74%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Tổng số sự kiện trong GameEvents</strong></td><td style="width:20.93%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>228 sự kiện</strong></td><td style="width:64.33%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_start</span> (46), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">dash_used</span> (35 - bản cũ), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_​complete</span> (31), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">game_exit</span> (25), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">game_start</span> (21), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">player_​level_​up</span> (14 - bản cũ), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">login</span> (12), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">player_dead</span> (11), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">weapon_​changed</span> (11 - bản cũ), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_failed</span> (8), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_up_heal</span> (8), khác (6).</td></tr><tr><td style="width:14.74%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Chỉ số Chiến đấu &amp; Phòng thủ lũy kế</strong></td><td style="width:20.93%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>211 quái bị hạ</strong></td><td style="width:64.33%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">- Tổng số quái tiêu diệt (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EnemiesKilled</span>): <strong>211 quái</strong>.<br/>- Tổng số pha Đỡ đòn thường (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BlockHits</span>): <strong>60 lần</strong>.<br/>- Tổng số pha Phản đòn hoàn hảo (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PerfectParries</span>): <strong>81 pha</strong> (Tỷ lệ <strong>Parry Mastery đạt 57.4%</strong> trên tổng số 141 pha phòng thủ).<br/>- Số lần dính Bẫy Gai (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrapHits</span>): <strong>2 lần</strong>.</td></tr><tr><td style="width:14.74%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Chỉ số Kinh tế Vàng &amp; Mua sắm</strong></td><td style="width:20.93%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>3.371 G thu thập</strong></td><td style="width:64.33%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">- Tổng vàng nhặt được (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldEarned</span>): <strong>3.371 Gold</strong>.<br/>- Tổng vàng đã tiêu (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldSpent</span>): <strong>1.550 Gold</strong> (Tỷ lệ tiêu vàng <strong>Spend Ratio đạt 46.0%</strong>).<br/>- Số lượt mua vũ khí trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span>: <strong>3 giao dịch</strong> (tại các Session <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#12</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#13</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#14</span> với tổng chi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">1.550 Gold</span>).</td></tr></table><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;"><strong>Nhận xét và đề xuất cân bằng game từ dữ liệu thực tế:</strong></p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Tác động rõ rệt của kỹ năng Perfect Parry và việc Mua vũ khí đến tỷ lệ Thắng ở Level 3:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Quan sát dữ liệu thực tế của các phiên chơi tại <strong>Level 3 (Pháo Đài Dung Nham – độ khó 1.50x)</strong>:</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Ở <strong>Session #6</strong> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerId = 5</span>), người chơi tiêu diệt được tới <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">52 quái</span> nhưng <strong>không sử dụng Đỡ đòn / Parry lần nào (BlockHits = 0, PerfectParries = 0)</strong> và <strong>không mua vũ khí mới (GoldSpent = 0)</strong> → Kết quả: <strong>Thua trận (Lose)</strong> sau 2 phút 14 giây.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Ngược lại, ở 3 phiên <strong>Session #12, #13, #14</strong> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerId = 6</span>), người chơi thực hiện từ <strong>16 đến 33 pha Perfect Parry mỗi trận</strong> và <strong>chi từ 450 G đến 550 G để nâng cấp vũ khí tại Lò Rèn</strong> → Kết quả: <strong>Chiến thắng cả 3 trận (Win)</strong> trong khoảng 3 đến 5 phút.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Điều này chứng minh cơ chế <strong>Perfect Parry hồi máu + gây choáng</strong> và <strong>Nâng cấp vũ khí tại Lò Rèn</strong> được thiết kế rất đúng mục tiêu, đóng vai trò quyết định để vượt qua bản đồ có độ khó cao nhất.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Phát hiện hành vi thoát sớm ở Level 1:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Tại <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 1</span>, có 5 phiên kết thúc với trạng thái <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Quit</span> chỉ sau <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">10–40 giây</span> (các Session <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#5</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#10</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#11</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#17</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#18</span> chỉ mới diệt từ 0 đến 7 quái). Đây là dấu hiệu của các phiên vào kiểm thử nhanh khi tinh chỉnh hiệu năng hoặc người chơi mới làm quen thao tác điều khiển.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Đánh giá mức độ nguy hiểm của Bẫy Gai:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Trong các phiên chơi gần đây, số lần dính Bẫy Gai (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrapHits</span>) rất thấp (chỉ 2 lần ở Session <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#12</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#14</span>), cho thấy vòng cảnh báo phát sáng màu đỏ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrapDangerRing</span>) dưới chân bẫy đã giúp người chơi dễ dàng nhận diện và né tránh. Nếu muốn tăng thử thách cho Khu vực 2 ở các bản cập nhật sau, nhóm có thể tăng nhẹ bán kính kích hoạt <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">triggerRadius</span> từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">1.65m</span> lên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">2.0m</span>.</p><hr style="border:none;border-bottom:1pt solid #cbd5e1;margin:12pt 0;"/><h1 style="font-family:'Times New Roman',serif;font-size:16pt;color:#1e3a8a;font-weight:bold;margin:16pt 0 8pt 0;page-break-after:avoid;">CHƯƠNG 9. KIỂM THỬ VÀ ĐÁNH GIÁ</h1><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">9.1. Mục tiêu kiểm thử</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Hoạt động kiểm thử (<em>Software &amp; Game Testing</em>) trong dự án nhằm xác minh tính đúng đắn, độ tin cậy và hiệu năng vận hành của toàn bộ chuỗi tích hợp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Unity Game Client</span> → <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ASP.NET Core Web API</span> → <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SQL Server Database</span> → <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Web Dashboard</span>. Các mục tiêu cụ thể bao gồm:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Đảm bảo tính chính xác của luồng dữ liệu Telemetry:</strong> Mọi hành động của người chơi trong game phải phát sinh đúng mã <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EventType</span>, đúng giá trị <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Value</span> và được Backend điều phối chính xác vào các bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Đảm bảo sự ổn định của Gameplay và Hiệu năng sau tối ưu giảm Lag:</strong> Các cơ chế đăng nhập, chọn nhân vật, chọn bản đồ, chiến đấu 3 màn, đỡ đòn/phản đòn, bẫy gai, cửa hàng Lò Rèn và màn hình Thắng/Thua hoạt động mượt mà ở mục tiêu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">60 FPS</span>, không bị khựng hình.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Đảm bảo tính nhất quán của các thuật toán Thống kê và Bộ lọc trên Dashboard:</strong> Số liệu hiển thị trên 5 thẻ KPI, 3 biểu đồ và cửa sổ Timeline phải khớp 100% với kết quả truy vấn trực tiếp trên SQL Server.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>4.</strong>&nbsp;<strong>Đảm bảo khả năng chịu lỗi (Fault Tolerance):</strong> Hệ thống không bị treo hoặc mất sự kiện khi mất kết nối mạng hoặc khi nhận dữ liệu đầu vào không hợp lệ.</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">9.2. Kế hoạch kiểm thử (Test Plan)</h2><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 9.1. Cấu hình môi trường và kế hoạch kiểm thử thực tế</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:11pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:28.21%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Hạng mục</th><th style="width:71.79%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Thông tin cấu hình kiểm thử thực tế</th></tr><tr><td style="width:28.21%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Hệ điều hành</strong></td><td style="width:71.79%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Microsoft Windows 10 / 11 (64-bit)</td></tr><tr><td style="width:28.21%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Môi trường Game Client</strong></td><td style="width:71.79%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Unity Editor <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">6000.3.19f1</span> (URP) – Chế độ Play Mode trên 7 Scenes (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoadingScene</span> → <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lv3</span>)</td></tr><tr><td style="width:28.21%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Môi trường Backend API</strong></td><td style="width:71.79%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">ASP.NET Core Web API (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">.NET 10.0</span>), biên dịch bằng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">dotnet build</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0 Error(s)</span>), chạy tại <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">https:/​/​localhost:7013</span> / <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">http:/​/​localhost:5295</span> và Dev Tunnel <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">https:/​/​sjf1zkj0-​7013.​asse.​devtunnels.​ms</span></td></tr><tr><td style="width:28.21%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Môi trường Cơ sở dữ liệu</strong></td><td style="width:71.79%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">SQL Server Express (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SEECONCAC\SQLEXPRESS</span>), CSDL <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span></td></tr><tr><td style="width:28.21%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Công cụ kiểm thử</strong></td><td style="width:71.79%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Unity Console Log, Swagger UI (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/swagger</span>), SQL Server Management Studio / <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sqlcmd</span>, Trình duyệt Web (Chrome/Edge DevTools) &amp; Công cụ Bot Giả lập tích hợp trên Dashboard</td></tr><tr><td style="width:28.21%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Phương pháp kiểm thử</strong></td><td style="width:71.79%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm thử hộp đen (<em>Black-box Testing</em>), Kiểm thử tích hợp (<em>Integration Testing</em>) và Kiểm thử khả năng chịu lỗi (<em>Error Handling Testing</em>)</td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">9.3. Kiểm thử Game Client</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Bảng 9.2 trình bày các kịch bản kiểm thử (<em>Test Cases</em>) đã thực hiện trên phân hệ Unity Game Client:</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 9.2. Danh sách Test Case kiểm thử Unity Game Client</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:6.26%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Mã TC</th><th style="width:16.6%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Tên kịch bản kiểm thử</th><th style="width:23.53%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Các bước thực hiện</th><th style="width:24.05%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Kết quả mong đợi</th><th style="width:24.05%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Kết quả thực tế (Bằng chứng trong dự án)</th><th style="width:5.51%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Trạng thái</th></tr><tr><td style="width:6.26%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-GC-01</strong></td><td style="width:16.6%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Nạp trước tài nguyên và chuyển cảnh tại <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoadingScene</span></td><td style="width:23.53%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Mở <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoadingScene</span> và nhấn Play trong Unity Editor.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameAssetPreloader</span> nạp đủ 31 tài nguyên cốt lõi, thanh tiến trình tăng mượt từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0%</span> lên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">100%</span> và chuyển sang <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoginScene</span>.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Toàn bộ 31 tài nguyên (UI, Roster, Rewards, 22 Audio) được nạp vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">assetCache</span>, không báo thiếu tài nguyên trong Console.</td><td style="width:5.51%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:6.26%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-GC-02</strong></td><td style="width:16.6%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đăng ký và Đăng nhập tài khoản tại <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoginScene</span></td><td style="width:23.53%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Nhập tài khoản mới (ví dụ: <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">a1234</span>, mật khẩu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&gt;= 6</span> ký tự), bấm Đăng ký rồi Đăng nhập.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Tạo tài khoản thành công, lưu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerId</span> vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerPrefs</span> và chuyển sang <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PickCharacter</span>.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Tài khoản <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">a1234</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerId = 11</span>) được lưu vào bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Players</span> lúc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">2026-11-21 18:24:44</span> với mật khẩu băm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">$pbkdf2$100000$.​.​.​</span>.</td><td style="width:5.51%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:6.26%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-GC-03</strong></td><td style="width:16.6%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Chọn nhân vật 3D và Chọn bản đồ chiến dịch</td><td style="width:23.53%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Tại <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PickCharacter</span> chọn 1 trong 4 nhân vật; sang <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PickMap</span> chọn 1 trong 3 bản đồ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lv1</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lv2</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lv3</span>) và bấm Vào trận.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Lưu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SelectedCharacterIndex</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SelectedMapIndex</span>, nạp đúng mô hình nhân vật, vũ khí khởi đầu và bản đồ tương ứng.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerCharacterLoader</span> thay đúng mô hình 3D, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">WeaponGripAligner</span> căn chỉnh kiếm khớp lòng bàn tay phải.</td><td style="width:5.51%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:6.26%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-GC-04</strong></td><td style="width:16.6%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Chiến đấu, Đỡ đòn (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Block</span>), Phản đòn (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Perfect Parry</span>) và Bẫy Gai</td><td style="width:23.53%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Điều khiển nhân vật chém quái (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LMB</span>), giữ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">RMB</span> đỡ đòn/parry và đi qua vùng Bẫy Gai ở Khu vực 2.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Giảm 72% sát thương khi Block; hồi 6% HP + làm choáng quái 1.6s khi Perfect Parry; trừ 18 HP khi dính bẫy; gửi đúng event về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager</span>.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span> (Session <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#12</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#13</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#14</span>), hệ thống ghi nhận chính xác <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BlockHits</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">2..6</span>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PerfectParries</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">16..33</span>) và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TrapHits</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">1</span>).</td><td style="width:5.51%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:6.26%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-GC-05</strong></td><td style="width:16.6%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Mở Cửa hàng Lò Rèn (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">[B]</span>/<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">[E]</span>) và mua Vũ khí / Bình máu</td><td style="width:23.53%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Nhặt vàng từ quái, nhấn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">[B]</span> mở cửa hàng, mua vũ khí mới và bình hồi máu.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Trừ đúng số vàng trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ScoreManager</span>, gắn vũ khí mới lên tay nhân vật kèm hiệu ứng nguyên tố, gửi event <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">weapon_​purchased</span> / <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">potion_​purchased</span>.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Các Session <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#12</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#13</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#14</span> ghi nhận <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldEarned</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">566..821 G</span>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldSpent</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">450..550 G</span>) và lưu 3 giao dịch vào bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span>.</td><td style="width:5.51%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:6.26%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-GC-06</strong></td><td style="width:16.6%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Hiệu năng sau tối ưu giảm giật lag</td><td style="width:23.53%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Chơi qua cả 3 khu vực của bản đồ, kích hoạt pha Boss Cuồng Nộ gọi viện binh và nhiều hiệu ứng hạt.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Trò chơi vận hành mượt, không bị khựng hình khi sinh đợt quái hoặc khi xuất hiện nhiều hiệu ứng máu/chém.</td><td style="width:24.05%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ApplyRuntimePerformanceOptimizations</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Object Pooling</span> trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CombatVfxManager</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Distance Culling</span> hoạt động ổn định, không phát sinh lỗi runtime.</td><td style="width:5.51%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">9.4. Kiểm thử REST API</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Bảng 9.3 trình bày kết quả kiểm thử các Endpoint của dự án <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryAPI</span> thông qua Swagger UI và luồng gọi thực tế từ Client:</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 9.3. Danh sách Test Case kiểm thử REST API</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:6.55%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Mã TC</th><th style="width:14.98%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Endpoint &amp; Method</th><th style="width:23.99%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Dữ liệu đầu vào (Input)</th><th style="width:23.57%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Kết quả mong đợi</th><th style="width:25.15%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Kết quả thực tế</th><th style="width:5.76%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Trạng thái</th></tr><tr><td style="width:6.55%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-API-01</strong></td><td style="width:14.98%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET /​api/​HealthCheck/​db</span></td><td style="width:23.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Không có tham số</td><td style="width:23.57%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Trả về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">HTTP 200 OK</span> xác nhận kết nối SQL Server thành công.</td><td style="width:25.15%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Trả về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">{ &quot;status&quot;: &quot;Success&quot;, &quot;message&quot;: &quot;Connected to SQL Server successfully!&quot; }</span>.</td><td style="width:5.76%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:6.55%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-API-02</strong></td><td style="width:14.98%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">POST /​api/​Players/​register</span></td><td style="width:23.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">{ &quot;playerName&quot;: &quot;a123&quot;, &quot;password&quot;: &quot;***&quot; }</span> (và thử gửi trùng tên lần 2)</td><td style="width:23.57%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Lần 1 trả về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">201 Created</span>; lần 2 trùng tên trả về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">409 Conflict</span>.</td><td style="width:25.15%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Lần 1 tạo <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerId = 10</span>; khi trùng tên trả về thông báo lỗi tiếng Việt rõ ràng với mã <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">409</span>.</td><td style="width:5.76%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:6.55%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-API-03</strong></td><td style="width:14.98%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">POST /​api/​Players/​login</span></td><td style="width:23.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Nhập đúng mật khẩu và thử nhập sai mật khẩu</td><td style="width:23.57%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đúng mật khẩu trả về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">200 OK</span>; sai mật khẩu trả về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">401 Unauthorized</span>.</td><td style="width:25.15%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PasswordHasherHelper.​Verify</span> xác thực chính xác hash <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PBKDF2-SHA256</span>.</td><td style="width:5.76%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:6.55%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-API-04</strong></td><td style="width:14.98%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">POST /​api/​Sessions/​start</span> &amp; <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PUT /​api/​Sessions/​{​id}​/​end</span></td><td style="width:23.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Mở phiên với <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">playerId = 6</span>, kết thúc phiên với <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">result = &quot;Win&quot;</span></td><td style="width:23.57%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Mở phiên trả về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">201 Created</span> kèm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionId</span>; đóng phiên cập nhật <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">endTime</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">result</span>.</td><td style="width:25.15%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Các Session <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#12</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#13</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#14</span> của <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerId = 6</span> đều được ghi nhận đầy đủ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">StartTime</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EndTime</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Result = &quot;Win&quot;</span>.</td><td style="width:5.76%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:6.55%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-API-05</strong></td><td style="width:14.98%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">POST /​api/​Events/​batch</span></td><td style="width:23.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Gửi lô sự kiện hỗn hợp gồm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_start</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">enemy_killed</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">gold_​collected</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">perfect_parry</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">weapon_​purchased</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">level_​complete</span></td><td style="width:23.57%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Sự kiện cột mốc lưu vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span>, mua đồ lưu vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span>, chỉ số chiến đấu cộng vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span>.</td><td style="width:25.15%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm tra Session <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#14</span> trong DB: <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span> lưu đúng 8 cột mốc (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EventId 670..767</span>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span> cộng đúng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">17</span> quái, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">566</span> vàng, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">16</span> parry.</td><td style="width:5.76%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:6.55%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-API-06</strong></td><td style="width:14.98%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET /​api/​Analytics/​*</span> (7 endpoints thống kê)</td><td style="width:23.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Gọi các API <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/overview</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/levels</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/economy</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/combat</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​sessions-​by-​date</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​recent-​sessions</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​sessions/​14/​events</span></td><td style="width:23.57%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Trả về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">HTTP 200 OK</span> với dữ liệu JSON đúng cấu trúc DTO và khớp số liệu trong SQL Server.</td><td style="width:25.15%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Toàn bộ 7 Endpoint phản hồi nhanh, không phát sinh lỗi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">500</span> hay lỗi ánh xạ kiểu dữ liệu.</td><td style="width:5.76%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">9.5. Kiểm thử Database</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Nhóm đã thực hiện kiểm thử trực tiếp trên máy chủ SQL Server <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SEECONCAC\SQLEXPRESS</span> bằng công cụ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sqlcmd</span> và SSMS để kiểm chứng tính toàn vẹn của cơ sở dữ liệu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>:</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 9.4. Danh sách Test Case kiểm thử Cơ sở dữ liệu SQL Server</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10.5pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:8.25%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Mã TC</th><th style="width:25.58%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Nội dung kiểm thử Database</th><th style="width:27.24%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Câu lệnh / Thao tác kiểm tra</th><th style="width:31.68%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Kết quả thực tế trên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span></th><th style="width:7.25%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Trạng thái</th></tr><tr><td style="width:8.25%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-DB-01</strong></td><td style="width:25.58%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm tra sự tồn tại và số lượng bản ghi của 5 bảng chuẩn hóa</td><td style="width:27.24%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Truy vấn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">COUNT(*)</span> trên 5 bảng trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>.</td><td style="width:31.68%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Cả 5 bảng hoạt động bình thường với dữ liệu thực tế: <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Players</span> (<strong>11 dòng</strong>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Levels</span> (<strong>3 dòng</strong>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span> (<strong>19 dòng</strong>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span> (<strong>3 dòng</strong>), <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span> (<strong>228 dòng</strong>).</td><td style="width:7.25%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:8.25%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-DB-02</strong></td><td style="width:25.58%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm tra ràng buộc bảo mật cột <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PasswordHash</span> và khóa <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">UNIQUE</span> của <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerName</span></td><td style="width:27.24%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm tra định dạng cột <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PasswordHash</span> trên 11 bản ghi trong bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Players</span>.</td><td style="width:31.68%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Các tài khoản mới (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerId 7..11</span>) đều lưu chuỗi hash chuẩn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">$pbkdf2$100000$.​.​.​</span>, không lưu mật khẩu dạng văn bản thuần.</td><td style="width:7.25%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:8.25%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-DB-03</strong></td><td style="width:25.58%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm tra kịch bản chuẩn hóa và di chuyển dữ liệu (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">04_​RedesignSchema_​Migration.​sql</span>)</td><td style="width:27.24%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đối chiếu dữ liệu giữa <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span> sau khi chạy migration.</td><td style="width:31.68%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Dữ liệu mua vũ khí được chuyển sang <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PurchaseId 1..3</span>), chỉ số chiến đấu/vàng được tổng hợp chính xác vào <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span> và bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span> đã được dọn gọn các sự kiện tần suất cao.</td><td style="width:7.25%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:8.25%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>TC-DB-04</strong></td><td style="width:25.58%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm tra 5 Nonclustered Indexes</td><td style="width:27.24%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Truy vấn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sys.indexes</span> trên các bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span>.</td><td style="width:31.68%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đầy đủ 5 chỉ mục (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IX_​GameSessions_​StartTime</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IX_​GameSessions_​PlayerId</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IX_​GameSessions_​LevelId</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IX_​GameEvents_​Session_​Type</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IX_​ShopPurchases_​SessionId</span>).</td><td style="width:7.25%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">9.6. Kiểm thử Dashboard</h2><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 9.5. Danh sách Test Case kiểm thử Web Dashboard</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10.5pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:8.45%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Mã TC</th><th style="width:22.99%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Hạng mục kiểm thử trên Dashboard</th><th style="width:28.73%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Thao tác thực hiện</th><th style="width:32.41%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Kết quả thực tế</th><th style="width:7.42%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Trạng thái</th></tr><tr><td style="width:8.45%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>TC-DBUI-01</strong></td><td style="width:22.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Hiển thị 5 thẻ KPI cốt lõi và đèn trạng thái kết nối</td><td style="width:28.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Mở trang Dashboard khi Backend đang chạy.</td><td style="width:32.41%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đèn trạng thái báo xanh <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SQL LIVE</span> kèm thời gian đồng bộ; 5 thẻ KPI hiển thị chính xác tổng số phiên, thời lượng trung bình, tỷ lệ thắng, Level hay thất bại nhất và tỷ lệ tiêu vàng.</td><td style="width:7.42%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:8.45%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>TC-DBUI-02</strong></td><td style="width:22.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Hiển thị 3 biểu đồ Chart.js và khung Chiến đấu cốt lõi</td><td style="width:28.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Quan sát biểu đồ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">levelFunnelChart</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionsDateChart</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">weaponPopularityChart</span> và khung Chiến đấu.</td><td style="width:32.41%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Các biểu đồ hiển thị đúng cột Bắt đầu / Hoàn thành / Thất bại của 3 Level, đường xu hướng theo ngày và thanh ngang vũ khí theo màu phẩm chất.</td><td style="width:7.42%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:8.45%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>TC-DBUI-03</strong></td><td style="width:22.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm thử Bộ lọc Thời gian và Bộ lọc Level</td><td style="width:28.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Lần lượt chọn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Hôm nay</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">7 ngày</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">30 ngày</span>, chọn <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 1</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 2</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Level 3</span> và bấm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Đặt lại</span>.</td><td style="width:32.41%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Khi đổi bộ lọc, hàm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">loadAllDashboardData(​false)​</span> gửi đúng query string <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">?​from=​.​.​.​&amp;​to=​.​.​.​&amp;​level=​.​.​.​</span> và làm mới toàn bộ số liệu trên màn hình.</td><td style="width:7.42%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:8.45%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>TC-DBUI-04</strong></td><td style="width:22.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Xem Modal Dòng thời gian sự kiện (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Session Timeline</span>) và Xuất CSV</td><td style="width:28.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Nhấp vào phiên chơi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#14</span> trong bảng nhật ký; bấm nút <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Xuất CSV</span>.</td><td style="width:32.41%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Cửa sổ Modal mở ra hiển thị 8 mốc sự kiện từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">+0s</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">game_start</span>) đến lúc kết thúc; nút <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Xuất CSV</span> tải về tệp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">.csv</span> hiển thị chuẩn tiếng Việt.</td><td style="width:7.42%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:8.45%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>TC-DBUI-05</strong></td><td style="width:22.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm thử công cụ Bot Giả lập (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Simulator Modal</span>)</td><td style="width:28.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Mở Modal <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Giả lập</span>, chọn kịch bản trận đấu và bấm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Chạy mô phỏng &amp; Gửi Telemetry</span>.</td><td style="width:32.41%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Bot tự động đăng ký/đăng nhập tài khoản (ví dụ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Bot_Ghost_774</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Bot_Ghost_835</span> đã lưu trong DB), mở Session, gửi chuỗi sự kiện và đóng Session thành công.</td><td style="width:7.42%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">9.7. Kiểm thử xử lý lỗi và mất mạng</h2><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 9.6. Danh sách Test Case kiểm thử xử lý lỗi và mất kết nối mạng</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10.5pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:8.54%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Mã TC</th><th style="width:23.62%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Tình huống lỗi giả lập</th><th style="width:27.53%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Cách thức kiểm thử</th><th style="width:32.79%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Kết quả xử lý thực tế của hệ thống</th><th style="width:7.52%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Trạng thái</th></tr><tr><td style="width:8.54%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>TC-ERR-01</strong></td><td style="width:23.62%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Tắt máy chủ Backend API khi người chơi đang chiến đấu trong Unity</td><td style="width:27.53%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Dừng tiến trình <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryAPI</span> khi đang chơi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Lv1</span>, tiếp tục hạ quái rồi thoát game.</td><td style="width:32.79%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Game vẫn chạy mượt mà ở 60 FPS, không bị treo. Console hiển thị cảnh báo sẽ thử gửi lại sau <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">5s</span> và lưu toàn bộ sự kiện chờ vào tệp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">telemetry_​offline_​queue.​json</span>.</td><td style="width:7.52%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:8.54%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>TC-ERR-02</strong></td><td style="width:23.62%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Bật lại máy chủ Backend API sau khi mất mạng</td><td style="width:27.53%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Khởi động lại <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryAPI</span> khi game đang mở (hoặc mở lại game ở phiên tiếp theo).</td><td style="width:32.79%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoadOfflineQueue(​)​</span> đọc lại tệp JSON trên ổ cứng và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ProcessPendingEventsCoroutine(​)​</span> gửi bù thành công lô sự kiện lên Server, sau đó xóa tệp tạm trên đĩa.</td><td style="width:7.52%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:8.54%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>TC-ERR-03</strong></td><td style="width:23.62%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Gửi sự kiện với <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SessionId</span> không tồn tại (ví dụ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SessionId = 999999</span>)</td><td style="width:27.53%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Gửi request <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">POST /api/Events</span> với <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">sessionId = 999999</span>.</td><td style="width:32.79%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">API trả về <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">HTTP 404 Not Found</span>. Phía Unity nhận mã <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">404</span> tự động hủy bỏ sự kiện mồ côi khỏi hàng đợi để không gây lặp vô hạn.</td><td style="width:7.52%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr><tr><td style="width:8.54%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>TC-ERR-04</strong></td><td style="width:23.62%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Mất kết nối API khi đang mở Web Dashboard</td><td style="width:27.53%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Tắt Backend API khi trang Dashboard đang mở trên trình duyệt.</td><td style="width:32.79%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Trong chu kỳ làm mới 12 giây tiếp theo, khối <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">catch (err)</span> bắt lỗi an toàn, chuyển đèn tín hiệu trên Header từ màu xanh <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SQL LIVE</span> sang màu đỏ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OFFLINE</span>.</td><td style="width:7.52%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>PASS</strong></td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">9.8. Kết quả kiểm thử</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Tổng hợp toàn bộ quá trình kiểm thử trên cả 5 hạng mục:</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 9.7. Bảng tổng hợp kết quả thực hiện các Test Case</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:10pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:6.97%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">STT</th><th style="width:32.99%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Hạng mục kiểm thử</th><th style="width:16.5%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Số lượng Test Case</th><th style="width:14.51%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Số TC Đạt (PASS)</th><th style="width:14.51%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Số TC Lỗi (FAIL)</th><th style="width:14.52%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Tỷ lệ hoàn thành</th></tr><tr><td style="width:6.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">1</td><td style="width:32.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm thử Unity Game Client &amp; Hiệu năng (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TC-GC</span>)</td><td style="width:16.5%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">6</td><td style="width:14.51%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">6</td><td style="width:14.51%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">0</td><td style="width:14.52%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">100%</span></td></tr><tr><td style="width:6.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">2</td><td style="width:32.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm thử Backend REST API (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TC-API</span>)</td><td style="width:16.5%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">6</td><td style="width:14.51%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">6</td><td style="width:14.51%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">0</td><td style="width:14.52%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">100%</span></td></tr><tr><td style="width:6.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">3</td><td style="width:32.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm thử Cơ sở dữ liệu SQL Server (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TC-DB</span>)</td><td style="width:16.5%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:14.51%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:14.51%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">0</td><td style="width:14.52%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">100%</span></td></tr><tr><td style="width:6.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:32.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm thử Giao diện Web Dashboard (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TC-DBUI</span>)</td><td style="width:16.5%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">5</td><td style="width:14.51%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">5</td><td style="width:14.51%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">0</td><td style="width:14.52%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">100%</span></td></tr><tr><td style="width:6.97%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">5</td><td style="width:32.99%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kiểm thử Xử lý lỗi &amp; Mất kết nối mạng (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TC-ERR</span>)</td><td style="width:16.5%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:14.51%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:14.51%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">0</td><td style="width:14.52%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">100%</span></td></tr><tr><td style="width:6.97%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;"><strong>Tổng cộng</strong></td><td style="width:32.99%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Toàn hệ thống Game Telemetry System</strong></td><td style="width:16.5%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>25</strong></td><td style="width:14.51%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>25</strong></td><td style="width:14.51%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>0</strong></td><td style="width:14.52%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>100%</strong></td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">9.9. Đánh giá kết quả</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Qua 25 kịch bản kiểm thử tích hợp và dữ liệu thực nghiệm ghi nhận trong cơ sở dữ liệu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>, hệ thống được đánh giá đạt chất lượng tốt trên các tiêu chí:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Đáp ứng đầy đủ 100% yêu cầu bắt buộc của đề tài:</strong> Hệ thống không chỉ thu thập đủ 7 sự kiện bắt buộc mà còn mở rộng lên 16 sự kiện bao quát cả chiến đấu và kinh tế; có REST API chuẩn hóa; có Database 5 bảng lưu đầy đủ <em>Player, Session, Event, Level, GameResult</em>; có Dashboard hiển thị hơn 5 chỉ số kèm 3 biểu đồ, bộ lọc Thời gian + Level và cơ chế Offline Queue khi mất mạng.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Độ trễ thấp và hiệu năng Game Client ổn định:</strong> Việc kết hợp các kỹ thuật tối ưu giảm giật lag (<em>Asset Preloading, Shader Warmup, Runtime Terrain Instancing, Object Pooling, Distance Culling, NonAlloc Physics</em>) cùng cơ chế gửi dữ liệu theo lô (<em>Debounced Batching 1.8s</em>) giúp trò chơi 3D vận hành mượt mà, không xảy ra xung đột tài nguyên giữa tác vụ đồ họa và tác vụ mạng.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Giá trị ứng dụng thực tiễn cao:</strong> Số liệu thu thập được trên Dashboard giúp nhìn nhận rõ mối tương quan giữa kỹ năng người chơi (<em>Perfect Parry</em>), quyết định mua sắm tại Lò Rèn và khả năng chiến thắng ở các màn chơi khó.</p><hr style="border:none;border-bottom:1pt solid #cbd5e1;margin:12pt 0;"/><h1 style="font-family:'Times New Roman',serif;font-size:16pt;color:#1e3a8a;font-weight:bold;margin:16pt 0 8pt 0;page-break-after:avoid;">CHƯƠNG 10. KẾT LUẬN VÀ HƯỚNG PHÁT TRIỂN</h1><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">10.1. Kết quả đạt được</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Sau quá trình phân tích, thiết kế, xây dựng và tối ưu hóa, nhóm đã hoàn thành dự án <strong>&quot;Hệ thống thu thập và phân tích dữ liệu người chơi (Game Telemetry System)&quot;</strong> với các kết quả cụ thể:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Xây dựng hoàn chỉnh trò chơi hành động 3D Vanguard: Raid of the Orc Woods trên Unity 6:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Gồm 7 Scene khép kín từ màn hình tải tài nguyên, đăng nhập/đăng ký, chọn 4 lớp nhân vật 3D, chọn 3 bản đồ chiến dịch 3D đến 3 cảnh chiến đấu có hệ thống AI quái theo đợt, bẫy gai, trại lửa checkpoint, đấu trường Boss 2 pha và cửa hàng Lò Rèn 8 vũ khí.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Đã thực hiện tối ưu hóa toàn diện để giảm hiện tượng giật lag khi tải cảnh và khi giao tranh đông quái.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Xây dựng bộ thu thập TelemetryManager tin cậy trên Unity:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Tự động thu thập 16 loại sự kiện người chơi, gom lô gửi bất đồng bộ qua <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Events/batch</span>, ưu tiên gửi tức thì cho các sự kiện kết thúc trận và tự động lưu tệp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">telemetry_offline_queue.json</span> kèm cơ chế thử lại mỗi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">5 giây</span> khi mất mạng.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Thiết kế Cơ sở dữ liệu GameTelemetryDB chuẩn hóa 5 bảng trên SQL Server và Backend ASP.NET Core Web API (.NET 10):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Triển khai cơ chế điều phối sự kiện thông minh trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EventsController</span> giúp tách bạch sự kiện cột mốc (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span>), giao dịch cửa hàng (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span>) và chỉ số lũy kế phiên chơi (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span>), giữ cho cơ sở dữ liệu luôn gọn nhẹ và truy vấn nhanh.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Tích hợp bảo mật băm mật khẩu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PBKDF2-SHA256</span> với 100.000 vòng lặp.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>4.</strong>&nbsp;<strong>Xây dựng Web Dashboard VANGUARD // TELEMETRY trực quan:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Hiển thị 5 thẻ KPI cốt lõi, 3 biểu đồ Chart.js, thống kê chiến đấu, thống kê kinh tế Lò Rèn, bộ lọc kết hợp Thời gian &amp; Level, cửa sổ xem Timeline từng phiên chơi, công cụ Bot giả lập và xuất tệp CSV.</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">10.2. Những hạn chế</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Bên cạnh những kết quả đã đạt được, hệ thống hiện tại vẫn còn một số hạn chế nhất định:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Dữ liệu lịch sử giữa các phiên bản Schema chưa hoàn toàn đồng nhất:</strong> Trong cơ sở dữ liệu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span> hiện tại, một số phiên chơi đầu tiên (từ Session <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#1</span> đến <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#9</span>) và 3 giao dịch mua vũ khí (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Vũ khí khác (bản cũ)</span> với giá <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">450 G</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">550 G</span>) được ghi nhận trước khi nhóm chuẩn hóa danh mục 8 vũ khí mới (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">75 G</span> – <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">720 G</span>), dẫn đến việc song hành cả dữ liệu bản cũ và bản mới trên biểu đồ kinh tế.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Chưa thu thập tọa độ không gian 3D (X, Y, Z) khi người chơi tử trận:</strong> Trường <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Value</span> của sự kiện <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">player_dead</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">trap_hit</span> hiện chỉ lưu một số nguyên (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LevelId</span> hoặc lượng sát thương), chưa lưu tọa độ vị trí chính xác trên địa hình <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Terrain</span> để dựng bản đồ nhiệt (<em>Spatial Heatmap</em>).</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Chưa có cơ chế tự động đóng các phiên chơi bị treo trên Server:</strong> Nếu máy tính của người chơi bị sập nguồn đột ngột khiến hàm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">OnApplicationQuit()</span> không kịp chạy, phiên chơi đó trong bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span> sẽ giữ giá trị <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EndTime = NULL</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Result = NULL</span> (như Session <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#1</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">#2</span> trong CSDL).</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">10.3. Những chức năng chưa hoàn thiện</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Tuân thủ nguyên tắc trung thực kỹ thuật, nhóm phân loại rõ trạng thái của các chức năng trong mã nguồn hiện tại như sau:</p><p style="text-align:left;color:#1e3a8a;margin:10pt 0 4pt 0;font-size:12.5pt;page-break-after:avoid;"><strong>Bảng 10.1. Phân loại trạng thái các chức năng của hệ thống</strong></p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:8pt 0 12pt 0;font-size:11pt;word-wrap:break-word;overflow-wrap:break-word;"><tr><th style="width:5.73%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">STT</th><th style="width:42.48%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Tên chức năng / Thành phần</th><th style="width:9.74%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:center;font-weight:bold;word-wrap:break-word;">Trạng thái hiện tại</th><th style="width:42.05%;border:1pt solid #475569;background:#1e3a8a;color:#ffffff;padding:4pt 5pt;text-align:left;font-weight:bold;word-wrap:break-word;">Giải thích chi tiết dựa trên Source Code</th></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">1</td><td style="width:42.48%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Luồng Đăng ký/Đăng nhập, Gameplay 3 Map, Cửa hàng 8 Vũ khí, Thu thập 16 sự kiện, Batching &amp; Offline Queue, 5 bảng SQL Server và Web Dashboard</td><td style="width:9.74%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Đã hoàn thành (100%)</strong></td><td style="width:42.05%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Đã triển khai đầy đủ trong mã nguồn, biên dịch <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0 Error(s)</span> và đã kiểm thử với dữ liệu thực tế trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">2</td><td style="width:42.48%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Một số trường thống kê phụ trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EconomyStatsDto</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopOpenCount</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopConversionPercent</span>) và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CombatStatsDto</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TotalKillScore</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">HealthPickups</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TotalHealthHealed</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">CheckpointsReached</span>)</td><td style="width:9.74%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Đang phát triển / Chưa gán lại sau chuẩn hóa DB</strong></td><td style="width:42.05%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Các thuộc tính này vẫn được khai báo trong tệp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">DTOs/​AnalyticsDtos.​cs</span>, nhưng sau khi chạy <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">04_​RedesignSchema_​Migration.​sql</span> để lược bỏ các sự kiện phụ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">shop_opened</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">item_pickup</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">checkpoint_​reached</span>) khỏi bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">AnalyticsController</span> hiện chỉ tính toán các chỉ số cốt lõi và chưa bổ sung cột đếm riêng cho 6 trường phụ này trên bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span>.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">3</td><td style="width:42.48%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Xác thực JWT Bearer Token cho các API gửi sự kiện và phân quyền trang quản trị Dashboard</td><td style="width:9.74%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Dự kiến phát triển</strong></td><td style="width:42.05%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Hiện tại API <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/​api/​Players/​login</span> đã xác thực mật khẩu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PBKDF2-SHA256</span>, nhưng chưa cấp chuỗi JWT Token để gắn vào Header <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Authorization</span> khi gọi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Sessions</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Events</span>, cũng như chưa có màn hình đăng nhập riêng cho Admin khi mở trang Dashboard.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">4</td><td style="width:42.48%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Lưu trữ đám mây (<em>Cloud Save</em>) cho tiến trình nhân vật và kho vũ khí giữa các phiên chơi</td><td style="width:9.74%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><strong>Dự kiến phát triển</strong></td><td style="width:42.05%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Hiện tại vàng và vũ khí mua tại Lò Rèn được đặt lại theo từng phiên chơi (<em>Session-based Roguelite</em>), chưa lưu bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PlayerInventory</span> trên SQL Server để giữ lại trang bị qua nhiều lần đăng nhập.</td></tr></table><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">10.4. Hướng phát triển trong tương lai</h2><p style="text-align:left;margin:5pt 0 8pt 0;line-height:1.45;font-size:13pt;word-wrap:break-word;">Để nâng cấp hệ thống lên mức độ hoàn thiện thương mại trong các giai đoạn tiếp theo, nhóm đề xuất 4 hướng phát triển trọng tâm:</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Bổ sung trường dữ liệu JSON mở rộng (MetadataJson) và Bản đồ nhiệt vị trí chết (Death Heatmap):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Bổ sung cột <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Metadata NVARCHAR(MAX)</span> vào bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span> để lưu tọa độ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">(x, y, z)</span> nơi nhân vật tử trận hoặc dính bẫy gai, từ đó vẽ bản đồ nhiệt 2D trực tiếp lên ảnh chụp mặt bằng của 3 bản đồ trên Dashboard.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Triển khai xác thực JWT (JSON Web Token) và Rate Limiting:</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Tích hợp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Microsoft.AspNetCore.Authentication.JwtBearer</span> để cấp Token sau khi người chơi đăng nhập thành công, bảo vệ các Endpoint <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Sessions</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">/api/Events/batch</span> khỏi các request giả mạo từ bên ngoài.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Xây dựng dịch vụ nền (Background Service) tự động dọn phiên treo (Heartbeat &amp; Session Timeout):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Bổ sung một <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">IHostedService</span> trong ASP.NET Core tự động đánh dấu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Result = &quot;Timeout&quot;</span> và cập nhật <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EndTime</span> dựa trên thời gian của sự kiện cuối cùng đối với các phiên chơi không có tín hiệu mới sau 30 phút.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>4.</strong>&nbsp;<strong>Cập nhật cân bằng game tự động từ Server (Remote Config):</strong></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Xây dựng thêm bảng cấu hình trên SQL Server và API <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET /api/Config/gameplay</span> để nhà phát triển có thể điều chỉnh trực tiếp máu Boss, sát thương bẫy gai hoặc giá của 8 vũ khí ngay trên Web Dashboard mà không cần biên dịch lại bản cài đặt Unity Client.</p><hr style="border:none;border-bottom:1pt solid #cbd5e1;margin:12pt 0;"/><h1 style="font-family:'Times New Roman',serif;font-size:16pt;color:#1e3a8a;font-weight:bold;margin:16pt 0 8pt 0;page-break-after:avoid;">DANH MỤC HÌNH ẢNH</h1><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 3.1.</strong> Sơ đồ kiến trúc tổng quan 4 tầng của hệ thống Game Telemetry System.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 3.2.</strong> Sơ đồ Use Case tổng quát cho hai nhóm đối tượng Người chơi và Nhà phân tích.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 3.3.</strong> Sơ đồ Activity mô tả quy trình thu thập, gom lô và xử lý mất mạng của <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 3.4.</strong> Sơ đồ Activity cơ chế phân tách sự kiện vào 3 bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 3.5.</strong> Sơ đồ luồng dữ liệu (DFD) mô tả 4 tiến trình xử lý chính và 5 kho dữ liệu của hệ thống.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 3.6.</strong> Sơ đồ thực thể liên kết (ERD) của 5 bảng dữ liệu trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 4.1.</strong> Sơ đồ tuần tự (Sequence Diagram) quy trình khởi tạo phiên, gom lô sự kiện và kết thúc phiên chơi.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 5.1.</strong> Cấu trúc 5 bảng dữ liệu của cơ sở dữ liệu <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span> trên SQL Server Management Studio.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 5.2.</strong> Kết quả thực thi các câu truy vấn thống kê dữ liệu thực tế trên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 6.1.</strong> Giao diện tài liệu và kiểm thử trực quan Swagger UI của hệ thống Backend <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryAPI</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 6.2.</strong> Kiểm thử Endpoint <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GET /api/Analytics/overview</span> trên Swagger UI trả về dữ liệu thống kê từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 7.1.</strong> Giao diện màn hình Tải tài nguyên (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoadingScene</span>) và màn hình Đăng nhập/Đăng ký (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">LoginScene</span>).</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 7.2.</strong> Giao diện sân khấu 3D Chọn Nhân vật (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PickCharacter</span>) và sa bàn 3D Chọn Bản đồ (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">PickMap</span>).</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 7.3.</strong> Giao diện chiến đấu trong trận, thanh máu Boss và bảng Cửa hàng Lò Rèn Vanguard.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 7.4.</strong> Giao diện thẻ tổng kết trận đấu khi Chiến thắng và khi Thất bại.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 8.1.</strong> Giao diện tổng thể của Web Dashboard phân tích dữ liệu người chơi <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">VANGUARD // TELEMETRY</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 8.2.</strong> Hiển thị 5 thẻ KPI cốt lõi và bảng phân tích Chiến đấu cốt lõi trên Dashboard.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 8.3.</strong> Các biểu đồ phân tích tỷ lệ qua màn theo Level, xu hướng phiên chơi theo ngày và thống kê mua vũ khí.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Hình 8.4.</strong> Cửa sổ xem dòng thời gian sự kiện chi tiết của một phiên chơi và công cụ Giả lập trận đấu kiểm thử.</p><hr style="border:none;border-bottom:1pt solid #cbd5e1;margin:12pt 0;"/><h1 style="font-family:'Times New Roman',serif;font-size:16pt;color:#1e3a8a;font-weight:bold;margin:16pt 0 8pt 0;page-break-after:avoid;">DANH MỤC BẢNG BIỂU</h1><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 1.1.</strong> Phân công nhiệm vụ các thành viên trong nhóm.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 1.2.</strong> Danh mục công nghệ và công cụ sử dụng trong dự án.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 2.1.</strong> Mô tả các đối tượng sử dụng hệ thống.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 2.2.</strong> Tổng hợp các sự kiện Telemetry thu thập trong hệ thống.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 3.1.</strong> Đặc tả Use Case UC03 &amp; UC05 – Chơi game và Thu thập sự kiện Telemetry.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 3.2.</strong> Đặc tả Use Case UC07..UC11 – Phân tích dữ liệu hành vi trên Dashboard.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 3.3.</strong> Tổng hợp các mối quan hệ giữa các bảng trong cơ sở dữ liệu.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 4.1.</strong> Danh mục chi tiết các sự kiện Telemetry trong hệ thống.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 4.2.</strong> Đặc tả cấu trúc trường dữ liệu của gói tin Event đơn lẻ.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 4.3.</strong> Tổng hợp các kịch bản lỗi và cơ chế xử lý trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">TelemetryManager</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 5.1.</strong> Mô tả các trường dữ liệu của bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Players</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 5.2.</strong> Mô tả các trường dữ liệu của bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Levels</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 5.3.</strong> Dữ liệu danh mục cố định được khởi tạo trong bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Levels</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 5.4.</strong> Mô tả các trường dữ liệu của bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameSessions</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 5.5.</strong> Mô tả các trường dữ liệu của bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ShopPurchases</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 5.6.</strong> Mô tả các trường dữ liệu của bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameEvents</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 5.7.</strong> Danh mục các Nonclustered Indexes tối ưu truy vấn trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 6.1.</strong> Bảng đặc tả các Endpoint nhận dữ liệu, xác thực và kiểm tra kết nối.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 6.2.</strong> Bảng đặc tả các Endpoint thống kê trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">AnalyticsController</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 7.1.</strong> Danh mục 8 Vũ khí và Bình hồi máu trong Cửa hàng Lò Rèn.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 7.2.</strong> Tổng hợp các kỹ thuật tối ưu hóa giảm giật lag đã triển khai trên Unity Client.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 7.3.</strong> Bảng ánh xạ các điểm chạm tích hợp Telemetry trong mã nguồn Unity Client.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 8.1.</strong> Mô tả chi tiết các chỉ số thống kê hiển thị trên Dashboard.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 8.2.</strong> Tổng hợp số liệu thực tế trích xuất từ <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 9.1.</strong> Cấu hình môi trường và kế hoạch kiểm thử thực tế.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 9.2.</strong> Danh sách Test Case kiểm thử Unity Game Client.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 9.3.</strong> Danh sách Test Case kiểm thử REST API.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 9.4.</strong> Danh sách Test Case kiểm thử Cơ sở dữ liệu SQL Server.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 9.5.</strong> Danh sách Test Case kiểm thử Web Dashboard.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 9.6.</strong> Danh sách Test Case kiểm thử xử lý lỗi và mất kết nối mạng.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 9.7.</strong> Bảng tổng hợp kết quả thực hiện các Test Case.</p><p style="text-align:left;margin:3pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Bảng 10.1.</strong> Phân loại trạng thái các chức năng của hệ thống.</p><hr style="border:none;border-bottom:1pt solid #cbd5e1;margin:12pt 0;"/><h1 style="font-family:'Times New Roman',serif;font-size:16pt;color:#1e3a8a;font-weight:bold;margin:16pt 0 8pt 0;page-break-after:avoid;">TÀI LIỆU THAM KHẢO</h1><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;<strong>Unity Technologies (2025),</strong> <em>Unity 6 Documentation – Universal Render Pipeline (URP), UnityWebRequest, NavMesh &amp; Performance Optimization</em>, truy cập tại: https://docs.unity3d.com/6000.0/Documentation/Manual/</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;<strong>Microsoft Corporation (2025),</strong> <em>ASP.NET Core Web API &amp; Entity Framework Core Documentation</em>, truy cập tại: https://learn.microsoft.com/en-us/aspnet/core/web-api/</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;<strong>Microsoft Corporation (2025),</strong> <em>SQL Server Technical Documentation – Indexing &amp; Transact-SQL Reference</em>, truy cập tại: https://learn.microsoft.com/en-us/sql/sql-server/</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>4.</strong>&nbsp;<strong>El-Nasr, M. S., Drachen, A., &amp; Canossa, A. (2013),</strong> <em>Game Analytics: Maximizing the Value of Player Data</em>, Springer-Verlag London.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>5.</strong>&nbsp;<strong>Chart.js Contributors (2024),</strong> <em>Chart.js 4.4 Documentation – Responsive HTML5 Charts</em>, truy cập tại: https://www.chartjs.org/docs/latest/</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>6.</strong>&nbsp;<strong>Tài liệu kỹ thuật &amp; Quy chuẩn phát triển dự án nội bộ tại Công ty Iku Studio,</strong> <em>Hướng dẫn kiến trúc Unity Game Client, tối ưu hóa hiệu năng 3D và tích hợp hệ thống Game Telemetry</em>.</p><hr style="border:none;border-bottom:1pt solid #cbd5e1;margin:12pt 0;"/><h1 style="font-family:'Times New Roman',serif;font-size:16pt;color:#1e3a8a;font-weight:bold;margin:16pt 0 8pt 0;page-break-after:avoid;">PHỤ LỤC: HƯỚNG DẪN CÀI ĐẶT VÀ VẬN HÀNH HỆ THỐNG</h1><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">Phụ lục A. Khởi tạo Cơ sở dữ liệu SQL Server (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>)</h2><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;Mở <strong>SQL Server Management Studio (SSMS)</strong> và đăng nhập vào instance SQL Server (ví dụ: <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">localhost\SQLEXPRESS</span> hoặc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SEECONCAC\SQLEXPRESS</span>).</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;Mở và chạy lần lượt các tệp kịch bản trong thư mục <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Database/</span>:</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Database/01_CreateDatabase.sql</span> (Tạo CSDL <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GameTelemetryDB</span>).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Database/02_CreateTables.sql</span> (Tạo 5 bảng chuẩn hóa, nạp 3 bản đồ vào bảng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Levels</span> và tạo 5 Indexes).</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Nếu nâng cấp từ cơ sở dữ liệu cũ, chạy thêm <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">03_AddPasswordToPlayers.sql</span> và <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">04_RedesignSchema_Migration.sql</span>.</p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">Phụ lục B. Cấu hình và Khởi chạy Backend REST API &amp; Web Dashboard</h2><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;Mở tệp <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Backend/GameTelemetryAPI/appsettings.json</span> và cập nhật tên <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Server=...</span> trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">DefaultConnection</span> khớp với tên máy chủ SQL Server trên máy.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;Mở Terminal / PowerShell tại thư mục gốc dự án và chạy lệnh:</p><table style="width:16.0cm;table-layout:fixed;border-collapse:collapse;margin:6pt 0 10pt 0;border:1pt solid #cbd5e1;border-left:3pt solid #1e3a8a;background:#f8fafc;"><tr><td style="padding:6pt 8pt;word-wrap:break-word;overflow-wrap:break-word;"><div style="color:#1e3a8a;font-family:Consolas,monospace;font-size:9pt;font-weight:bold;margin-bottom:3pt;">[POWERSHELL]</div><div style="font-family:Consolas,monospace;font-size:8.5pt;color:#0f172a;line-height:1.3;word-wrap:break-word;">&nbsp;&nbsp;&nbsp;dotnet run --project &quot;Backend/​GameTelemetryAPI/​GameTelemetryAPI.​csproj&quot;</div></td></tr></table><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;Truy cập các đường dẫn sau trên trình duyệt:</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Giao diện Web Dashboard:</strong> <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">http://localhost:5295/</span> (hoặc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">https://localhost:7013/</span>)</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Giao diện kiểm thử Swagger UI:</strong> <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">http://localhost:5295/swagger</span></p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;<strong>Kiểm tra kết nối Database:</strong> <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">http://localhost:5295/api/HealthCheck/db</span></p><h2 style="font-family:'Times New Roman',serif;font-size:14pt;color:#0f172a;font-weight:bold;margin:13pt 0 6pt 0;page-break-after:avoid;">Phụ lục C. Khởi chạy Unity Game Client</h2><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>1.</strong>&nbsp;Mở dự án trong <strong>Unity Hub</strong> với phiên bản <strong>Unity 6000.3.19f1</strong>.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>2.</strong>&nbsp;Kiểm tra địa chỉ máy chủ trong <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Assets/DucThanh/Scripts/Networking/AuthApiClient.cs</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">ApiConfig.DEFAULT_BASE_URL</span>):</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Đặt <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;http://localhost:5295&quot;</span> hoặc <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;https://localhost:7013&quot;</span> nếu chạy cục bộ trên cùng máy tính.</p><p style="text-align:left;margin:3pt 0 4pt 28pt;line-height:1.4;font-size:13pt;word-wrap:break-word;">&bull;&nbsp;&nbsp;Đặt đường dẫn Dev Tunnel nếu chạy demo kết nối qua mạng Internet.</p><p style="text-align:left;margin:4pt 0 4pt 14pt;line-height:1.4;font-size:13pt;word-wrap:break-word;"><strong>3.</strong>&nbsp;Mở cảnh <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Assets/DucThanh/Scene/LoadingScene.unity</span> và nhấn nút <strong>Play</strong> để trải nghiệm toàn bộ luồng từ Tải tài nguyên → Đăng nhập → Chọn Nhân vật → Chọn Bản đồ → Chiến đấu và đối chiếu số liệu trực tiếp trên Web Dashboard.</p>
</div>
</body>
</html>
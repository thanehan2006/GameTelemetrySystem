:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">SYSUTCDATETIME(​)​</span></td><td style="width:36.48%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Thời điểm bắt đầu phiên chơi (UTC).</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">5</td><td style="width:12.32%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EndTime</span></td><td style="width:12.38%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">DATETIME2</span></td><td style="width:11.94%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">DateTime?</span></td><td style="width:9.9%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NULL</span></td><td style="width:11.25%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NULL</span></td><td style="width:36.48%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Thời điểm kết thúc phiên chơi (UTC). Bằng <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NULL</span> nếu phiên đang diễn ra hoặc bị ngắt đột ngột.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">6</td><td style="width:12.32%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">Result</span></td><td style="width:12.38%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NVARCHAR(20)</span></td><td style="width:11.94%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">string?</span></td><td style="width:9.9%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NULL</span></td><td style="width:11.25%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NULL</span></td><td style="width:36.48%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Kết quả trận đấu (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;Win&quot;</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;Lose&quot;</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;Quit&quot;</span>, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">&quot;Victory&quot;</span>).</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">7</td><td style="width:12.32%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">EnemiesKilled</span></td><td style="width:12.38%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">INT</span></td><td style="width:11.94%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">int</span></td><td style="width:9.9%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NOT NULL</span></td><td style="width:11.25%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0</span></td><td style="width:36.48%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Tổng số quái vật người chơi đã tiêu diệt trong phiên.</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">8</td><td style="width:12.32%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BossKilled</span></td><td style="width:12.38%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">BIT</span></td><td style="width:11.94%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">bool</span></td><td style="width:9.9%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">NOT NULL</span></td><td style="width:11.25%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0</span> (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">false</span>)</td><td style="width:36.48%;border:1pt solid #94a3b8;background:#f8fafc;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;">Cờ đánh dấu người chơi đã hạ gục Boss cuối của bản đồ hay chưa (<span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">1</span> = Đã hạ, <span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">0</span> = Chưa).</td></tr><tr><td style="width:5.73%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:center;vertical-align:middle;word-wrap:break-word;">9</td><td style="width:12.32%;border:1pt solid #94a3b8;background:#ffffff;padding:4pt 5pt;text-align:left;vertical-align:middle;word-wrap:break-word;"><span style="font-family:Consolas,monospace;background:#f1f5f9;font-size:10pt;">GoldEarned</span></td><td style="width:12.38%;border:1pt solid #94a3b8;background: